at" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="745" y="270" width="64" height="40" as="geometry"/></mxCell><mxCell id="pd-35" value="and" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="997" y="270" width="64" height="40" as="geometry"/></mxCell><mxCell id="pd-36" value="purred" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1249" y="270" width="64" height="40" as="geometry"/></mxCell><mxCell id="pd-37" value="." style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1501" y="270" width="64" height="40" as="geometry"/></mxCell><mxCell id="pd-38" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pd-28" target="pd-34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pd-39" value="&lt;b&gt;step 1&lt;/b&gt; · position 6" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="813" y="212" width="180" height="20" as="geometry"/></mxCell><mxCell id="pd-40" value="&lt;b&gt;Transformer&lt;/b&gt;&lt;br&gt;(all L layers)&lt;br&gt;1 token: x ∈ ℝ&lt;sup&gt;1×d&lt;/sup&gt;&lt;br&gt;&lt;i&gt;matrix × vector&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="833" y="240" width="140" height="100" as="geometry"/></mxCell><mxCell id="pd-41" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pd-34" target="pd-40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p