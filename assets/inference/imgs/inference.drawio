<mxfile host="Electron" agent="python" version="24.7.17" type="device" pages="8"><diagram id="pd" name="1 · Prefill &amp; Decode"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="930" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pd-2" value="LLM inference on one sequence: Prefill → Decode" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1560" height="36" as="geometry"/></mxCell><mxCell id="pd-3" value="Prefill runs the whole prompt through the model in one forward pass and fills the KV cache. Decode then generates one token per forward pass, reusing and extending that cache." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1560" height="40" as="geometry"/></mxCell><mxCell id="pd-4" value="① PREFILL — prompt phase" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=16;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fillColor=#f5f9fe;strokeColor=#6c8ebf;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="640" height="490" as="geometry"/></mxCell><mxCell id="pd-5" value="② DECODE — generation phase" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=16;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fillColor=#f6fbf4;strokeColor=#82b366;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="720" y="100" width="880" height="490" as="geometry"/></mxCell><mxCell id="pd-6" value="Prompt: n = 5 tokens, all fed into &lt;b&gt;one&lt;/b&gt; forward pass (positions in parallel)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="132" width="610" height="20" as="geometry"/></mxCell><mxCell id="pd-7" value="&lt;b&gt;Transformer forward pass (all L layers)&lt;/b&gt;&lt;br&gt;X ∈ ℝ&lt;sup&gt;n×d&lt;/sup&gt; → Q, K, V = X·W&lt;sub&gt;Q&lt;/sub&gt;, X·W&lt;sub&gt;K&lt;/sub&gt;, X·W&lt;sub&gt;V&lt;/sub&gt;&lt;br&gt;causal attention over n×n scores, then MLP&lt;br&gt;&lt;i&gt;matrix × matrix (GEMM)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="60" y="240" width="380" height="100" as="geometry"/></mxCell><mxCell id="pd-8" value='The&lt;br&gt;&lt;span style="font-size:10px;color:#666666"&gt;pos 1&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="61" y="166" width="66" height="40" as="geometry"/></mxCell><mxCell id="pd-9" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.0895;entryY=0;" edge="1" parent="1" source="pd-8" target="pd-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pd-10" value='cat&lt;br&gt;&lt;span style="font-size:10px;color:#666666"&gt;pos 2&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="139" y="166" width="66" height="40" as="geometry"/></mxCell><mxCell id="pd-11" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.2947;entryY=0;" edge="1" parent="1" source="pd-10" target="pd-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pd-12" value='sat&lt;br&gt;&lt;span style="font-size:10px;color:#666666"&gt;pos 3&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="217" y="166" width="66" height="40" as="geometry"/></mxCell><mxCell id="pd-13" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pd-12" target="pd-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pd-14" value='on&lt;br&gt;&lt;span style="font-size:10px;color:#666666"&gt;pos 4&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="295" y="166" width="66" height="40" as="geometry"/></mxCell><mxCell id="pd-15" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.7053;entryY=0;" edge="1" parent="1" source="pd-14" target="pd-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pd-16" value='the&lt;br&gt;&lt;span style="font-size:10px;color:#666666"&gt;pos 5&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="373" y="166" width="66" height="40" as="geometry"/></mxCell><mxCell id="pd-17" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.9105;entryY=0;" edge="1" parent="1" source="pd-16" target="pd-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pd-18" value="K&lt;sub&gt;1&lt;/sub&gt; V&lt;sub&gt;1&lt;/sub&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="60" height="32" as="geometry"/></mxCell><mxCell id="pd-19" value="K&lt;sub&gt;2&lt;/sub&gt; V&lt;sub&gt;2&lt;/sub&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="120" y="400" width="60" height="32" as="geometry"/></mxCell><mxCell id="pd-20" value="K&lt;s