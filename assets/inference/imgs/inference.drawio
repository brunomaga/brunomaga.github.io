ght="22" as="geometry"/></mxCell><mxCell id="rb-352" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#e0e0e0;" vertex="1" parent="1"><mxGeometry x="414" y="872" width="22" height="22" as="geometry"/></mxCell><mxCell id="rb-353" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="436" y="872" width="22" height="22" as="geometry"/></mxCell><mxCell id="rb-354" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="458" y="872" width="22" height="22" as="geometry"/></mxCell><mxCell id="rb-355" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="480" y="872" width="22" height="22" as="geometry"/></mxCell><mxCell id="rb-356" value="• Token i may attend to token j only if both belong to the &lt;b&gt;same sequence&lt;/b&gt; and j ≤ i&lt;br&gt;• So the mask is block-diagonal: one causal triangle per sequence&lt;br&gt;• Varlen attention kernels (e.g. FlashAttention varlen) take cu_seqlens and skip fully masked tiles — this matrix is never materialised&lt;br&gt;• Attention work ∝ Σ len&lt;sub&gt;i&lt;/sub&gt;² = 74 instead of batch × max_len² = 144" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530" y="542" width="350" height="360" as="geometry"/></mxCell><mxCell id="rb-357" value="④ In serving: prefill and decode segments share one batch" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=16;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fillColor=#fffaf3;strokeColor=#d79b00;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="940" y="450" width="660" height="470" as="geometry"/></mxCell><mxCell id="rb-358" value="The same layout mixes different kinds of work. Here: a new request E (6 prompt tokens) plus one decode token each for running requests A, B, C." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="486" width="620" height="40" as="geometry"/></mxCell><mxCell id="rb-359" value="E1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="970" y="580" width="52" height="40" as="geometry"/></mxCell><mxCell id="rb-360" value="E2" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1022" y="580" width="52" height="40" as="geometry"/></mxCell><mxCell id="rb-361" value="E3" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1074" y="580" width="52" height="40" as="geometry"/></mxCell><mxCell id="rb-362" value="E4" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1126" y="580" width="52" height="40" as="geometry"/></mxCell><mxCell id="rb-363" value="E5" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1178" y="580" width="52" height="40" as="geometry"/></mxCell><mxCell id="rb-364" value="E6" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1230" y="580" width="52" height="40" as="geometry"/></mxCell><mxCell id="rb-365" value="a" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1282" y="580" width="52" height="40" as="geometry"/></mxCell><mxCell id="rb-366" value="b" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5