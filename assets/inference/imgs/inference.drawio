2;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="500" y="510" width="34" height="34" as="geometry"/></mxCell><mxCell id="mm-121" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="534" y="510" width="34" height="34" as="geometry"/></mxCell><mxCell id="mm-122" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="568" y="510" width="34" height="34" as="geometry"/></mxCell><mxCell id="mm-123" value="&lt;b&gt;B&lt;/b&gt;  (K × N)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="128" width="272" height="20" as="geometry"/></mxCell><mxCell id="mm-124" value="&lt;b&gt;A&lt;/b&gt;  (M × K)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="130" y="548" width="170" height="20" as="geometry"/></mxCell><mxCell id="mm-125" value="&lt;b&gt;C&lt;/b&gt;  (M × N)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="548" width="272" height="20" as="geometry"/></mxCell><mxCell id="mm-126" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;strokeColor=#3a5f9a;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="198" y="425.0" as="sourcePoint"/><mxPoint x="500" y="425.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="mm-127" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;strokeColor=#4d8a2e;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="517.0" y="218" as="sourcePoint"/><mxPoint x="517.0" y="408" as="targetPoint"/></mxGeometry></mxCell><mxCell id="mm-128" value='Tile sizes:&lt;br&gt;C tile BM × BN&lt;br&gt;A tile BM × BK&lt;br&gt;B tile BK × BN&lt;br&gt;&lt;span style="font-size:11px;color:#555555"&gt;typical: BM = BN = 128, BK = 32–64&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="250" height="150" as="geometry"/></mxCell><mxCell id="mm-129" value="Thread block (i, j) owns tile C&lt;sub&gt;ij&lt;/sub&gt; and loops over k: C&lt;sub&gt;ij&lt;/sub&gt; += A&lt;sub&gt;ik&lt;/sub&gt; · B&lt;sub&gt;kj&lt;/sub&gt;. The grid has ⌈M/BM⌉ × ⌈N/BN⌉ thread blocks, spread over all SMs." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="580" width="600" height="80" as="geometry"/></mxCell><mxCell id="mm-130" value="② Where the data lives (H100 SXM)" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=16;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fillColor=#faf6fc;strokeColor=#9673a6;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="720" y="100" width="440" height="570" as="geometry"/></mxCell><mxCell id="mm-131" value="Streaming Multiprocessor (SM) · 132 per GPU" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fillColor=#faf6fc;strokeColor=#9673a6;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="745" y="140" width="390" height="340" as="geometry"/></mxCell><mxCell id="mm-132" value="Tensor&lt;br&gt;Core" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="765" y="172" width="80" height="44" as="geometry"/></mxCell><mxCell id="mm-133" value="Tensor&lt;br&gt;Core" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="853" y="172" width="80" height="44" as="geometry"/></mxCell><mxCell id="mm-134" value="Tensor&lt;br&gt;Core" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="941" y="172" width="80" height="44" as="geometry"/></mxCell><mxCell id="mm-135" value="Tensor&lt;br&gt;Core" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1029" y="172" width="80" height="44" as="geometry"/></mxCell><mxCell id="mm-136" value="4 Tensor Cores: matrix-multiply-accumulate on small tiles" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="765" y="220" width="320" height="18" as="geometry"/></mxCell><mxCell id="mm-137" value="&lt;b&gt;Registers&lt;/b&gt; · 256 KB / SM" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="765" y="262" width="350" height="40" as="geometry"/></mxCell><mxCell id="mm-138" value="warps (32 threads each) hold fragments of acc" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="765" y="306" width="320" height="30" as="geometry"/></mxCell><mxCell id="mm-139" value="&lt;b&gt;Shared memory / L1&lt;/b&gt; · up to 228 KB / SM" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="765" y="346" width="350" height="44" as="geometry"/></mxCell><mxCell id="mm-140" value="tiles sA, sB of one thread block, reused by all its warps" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="765" y="394" width="320" height="30" as="geometry"/></mxCell><mxCell id="mm-141" value="a thread block (CTA) runs on one SM; many blocks run in parallel across the SMs" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="765" y="432" width="340" height="40" as="geometry"/></mxCell><mxCell id="mm-142" value="&lt;b&gt;L2 cache&lt;/b&gt; · 50 MB, shared by all SMs" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="745" y="510" width="390" height="40" as="geometry"/></mxCell><mxCell id="mm-143" value='&lt;b&gt;HBM3&lt;/b&gt; (global memory) · 80 GB · ~3.35 TB/s&lt;br&gt;&lt;span style="font-size:11px;color:#555555"&gt;A, B and C live here&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="745" y="590" width="390" height="50" as="geometry"/></mxCell><mxCell id="mm-144" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1095" y="590" as="sourcePoint"/><mxPoint x="1095" y="550" as="targetPoint"/></mxGeometry></mxCell><mxCell id="mm-145" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1095" y="510" as="sourcePoint"/><mxPoint x="1095" y="390" as="targetPoint"/></mxGeometry></mxCell><mxCell id="mm-146" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1095" y="346" as="sourcePoint"/><mxPoint x="1095" y="302" as="targetPoint"/></mxGeometry></mxCell><mxCell id="mm-147" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;startArrow=block;startFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1095" y="262" as="sourcePoint"/><mxPoint x="1095" y="216" as="targetPoint"/></mxGeometry></mxCell><mxCell id="mm-148" value="③ Kernel for one thread block" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=16;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fillColor=#fafafa;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1200" y="100" width="400" height="570" as="geometry"/></mxCell><mxCell id="mm-149" value="#&amp;nbsp;grid&amp;nbsp;=&amp;nbsp;⌈M/BM⌉&amp;nbsp;×&amp;nbsp;⌈N/BN⌉&amp;nbsp;thread&amp;nbsp;blocks&lt;br&gt;i,&amp;nbsp;j&amp;nbsp;=&amp;nbsp;blockIdx.y,&amp;nbsp;blockIdx.x&lt;br&gt;acc&amp;nbsp;=&amp;nbsp;zeros(BM,&amp;nbsp;BN)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;#&amp;nbsp;registers&lt;br&gt;for&amp;nbsp;k&amp;nbsp;in&amp;nbsp;range(0,&amp;nbsp;K,&amp;nbsp;BK):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;sA&amp;nbsp;=&amp;nbsp;A[i·BM:(i+1)·BM,&amp;nbsp;k:k+BK]&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;sB&amp;nbsp;=&amp;nbsp;B[k:k+BK,&amp;nbsp;j·BN:(j+1)·BN]&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;sync()&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;#&amp;nbsp;tiles&amp;nbsp;in&amp;nbsp;SMEM&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;acc&amp;nbsp;+=&amp;nbsp;sA&amp;nbsp;@&amp;nbsp;sB&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;#&amp;nbsp;Tensor&amp;nbsp;Cores&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;sync()&lt;br&gt;C[i·BM:(i+1)·BM,&amp;nbsp;j·BN:(j+1)·BN]&amp;nbsp;=&amp;nbsp;acc" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1215" y="140" width="370" height="165" as="geometry"/></mxCell><mxCell id="mm-150" value="• HBM → SMEM: each A element is loaded ⌈N/BN⌉ times (not N times), each B element ⌈M/BM⌉ times → bigger tiles = more reuse&lt;br&gt;• SMEM → registers → Tensor Cores: product of the two tiles&lt;br&gt;• Result tile is written back to HBM once&lt;br&gt;• Libraries: cuBLAS, CUTLASS, Triton" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1215" y="318" width="370" height="130" as="geometry"/></mxCell><mxCell id="mm-151" value="&lt;b&gt;Software pipelining (double buffering)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1215" y="462" width="370" height="20" as="geometry"/></mxCell><mxCell id="mm-152" value="load" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1215" y="492" width="60" height="26" as="geometry"/></mxCell><mxCell id="mm-153" value="MMA" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1215" y="524" width="60" height="26" as="geometry"/></mxCell><mxCell id="mm-154" value="tile 0" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1280" y="492" width="56" height="26" as="geometry"/></mxCell><mxCell id="mm-155" value="tile 0" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1340" y="524" width="56" height="26" as="geometry"/></mxCell><mxCell id="mm-156" value="tile 1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1340" y="492" width="56" height="26" as="geometry"/></mxCell><mxCell id="mm-157" value="tile 1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1400" y="524" width="56" height="26" as="geometry"/></mxCell><mxCell id="mm-158" value="tile 2" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1400" y="492" width="56" height="26" as="geometry"/></mxCell><mxCell id="mm-159" value="tile 2" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1460" y="524" width="56" height="26" as="geometry"/></mxCell><mxCell id="mm-160" value="tile 3" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1460" y="492" width="56" height="26" as="geometry"/></mxCell><mxCell id="mm-161" value="tile 3" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1520" y="524" width="56" height="26" as="geometry"/></mxCell><mxCell id="mm-162" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1;endSize=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1280" y="560" as="sourcePoint"/><mxPoint x="1580" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="mm-163" value="time" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1540" y="562" width="40" height="14" as="geometry"/></mxCell><mxCell id="mm-164" value="While the Tensor Cores work on tile k, the next tile is already being copied into a second shared-memory buffer (cp.async on Ampere, TMA on Hopper)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1215" y="580" width="370" height="70" as="geometry"/></mxCell><mxCell id="mm-165" value="④ Arithmetic intensity: why prefill is compute-bound and decode is memory-bound" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=16;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fillColor=#fafafa;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1560" height="345" as="geometry"/></mxCell><mxCell id="mm-166" value="Linear layer Y = X·W — X: M×d activations, W: d×d weights (FP16, 2 bytes)&lt;br&gt;FLOPs = 2·M·d²     bytes moved ≈ 2·d² (the weights dominate when M ≪ d)&lt;br&gt;⇒ arithmetic intensity ≈ &lt;b&gt;M FLOP/byte&lt;/b&gt;&lt;br&gt;H100 SXM ridge point: 989 TFLOP/s (dense BF16) ÷ 3.35 TB/s ≈ &lt;b&gt;295 FLOP/byte&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="740" width="900" height="110" as="geometry"/></mxCell><mxCell id="mm-167" value="&lt;b&gt;Prefill&lt;/b&gt;: M = prompt tokens (e.g. 2,048)&lt;br&gt;→ ~1,000 FLOP/byte ≫ 295 → &lt;b&gt;compute-bound&lt;/b&gt; (GEMM)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="840" width="440" height="70" as="geometry"/></mxCell><mxCell id="mm-168" value="&lt;b&gt;Decode&lt;/b&gt;: M = batch size (e.g. 8)&lt;br&gt;→ ~8 FLOP/byte ≪ 295 → &lt;b&gt;memory-bound&lt;/b&gt;; bigger batches help" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="520" y="840" width="440" height="70" as="geometry"/></mxCell><mxCell id="mm-169" value="Attention over the KV cache stays memory-bound in decode even with batching: each sequence reads its own K,V (only a few FLOPs per byte loaded)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="60" y="926" width="900" height="40" as="geometry"/></mxCell><mxCell id="mm-170" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1120" y="1000" as="sourcePoint"/><mxPoint x="1465" y="1000" as="targetPoint"/></mxGeometry></mxCell><mxCell id="mm-171" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1120" y="1000" as="sourcePoint"/><mxPoint x="1120" y="740.3842966722257" as="targetPoint"/></mxGeometry></mxCell><mxCell id="mm-172" value="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1100.0" y="1002" width="40" height="14" as="geometry"/></mxCell><mxCell id="mm-173" value="10" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1180.0" y="1002" width="40" height="14" as="geometry"/></mxCell><mxCell id="mm-174" value="100" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1260.0" y="1002" width="40" height="14" as="geometry"/></mxCell><mxCell id="mm-175" value="1K" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1340.0" y="1002" width="40" height="14" as="geometry"/></mxCell><mxCell id="mm-176" value="10K" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1420.0" y="1002" width="40" height="14" as="geometry"/></mxCell><mxCell id="mm-177" value="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1076" y="992.0" width="40" height="16" as="geometry"/></mxCell><mxCell id="mm-178" value="10" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1076" y="912.0" width="40" height="16" as="geometry"/></mxCell><mxCell id="mm-179" value="100" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1076" y="832.0" width="40" height="16" as="geometry"/></mxCell><mxCell id="mm-180" value="1000" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1076" y="752.0" width="40" height="16" as="geometry"/></mxCell><mxCell id="mm-181" value="arithmetic intensity (FLOP/byte, log)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="1016" width="340" height="16" as="geometry"/></mxCell><mxCell id="mm-182" value="attainable TFLOP/s (log)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1070" y="720.3842966722257" width="160" height="16" as="geometry"/></mxCell><mxCell id="mm-183" value="" style="html=1;rounded=0;endArrow=none;endFill=1;strokeWidth=3;strokeColor=#d79b00;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1120.0" y="957.9964154370524" as="sourcePoint"/><mxPoint x="1317.6121187648268" y="760.3842966722257" as="targetPoint"/></mxGeometry></mxCell><mxCell id="mm-184" value="" style="html=1;rounded=0;endArrow=none;endFill=1;strokeWidth=3;strokeColor=#9673a6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1317.6121187648268" y="760.3842966722257" as="sourcePoint"/><mxPoint x="1440.0" y="760.3842966722257" as="targetPoint"/></mxGeometry></mxCell><mxCell id="mm-185" value="" style="html=1;rounded=0;endArrow=none;endFill=1;strokeWidth=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1317.6121187648268" y="760.3842966722257" as="sourcePoint"/><mxPoint x="1317.6121187648268" y="1000" as="targetPoint"/></mxGeometry></mxCell><mxCell id="mm-186" value="ridge&lt;br&gt;≈ 295" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1321.6121187648268" y="966" width="80" height="30" as="geometry"/></mxCell><mxCell id="mm-187" value="compute roof 989" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1376" y="738.3842966722257" width="130" height="16" as="geometry"/></mxCell><mxCell id="mm-188" value="memory roof&lt;br&gt;3.35 TB/s × I" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#9a6a00;" vertex="1" parent="1"><mxGeometry x="1124" y="822" width="90" height="30" as="geometry"/></mxCell><mxCell id="mm-189" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=#4d8a2e;" vertex="1" parent="1"><mxGeometry x="1186.2471989593555" y="879.7492164776969" width="12" height="12" as="geometry"/></mxCell><mxCell id="mm-190" value="decode, batch 8" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#2d7a2d;" vertex="1" parent="1"><mxGeometry x="1202.2471989593555" y="881.7492164776969" width="120" height="16" as="geometry"/></mxCell><mxCell id="mm-191" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#3a5f9a;" vertex="1" parent="1"><mxGeometry x="1354.823996531185" y="754.3842966722257" width="12" height="12" as="geometry"/></mxCell><mxCell id="mm-192" value="prefill, 2K tokens" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#3a5f9a;" vertex="1" parent="1"><mxGeometry x="1310.823996531185" y="768.3842966722257" width="120" height="16" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pa" name="4 · PagedAttention"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="980" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pa-2" value="PagedAttention (vLLM): the KV cache in fixed-size blocks, mapped like virtual-memory pages" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1560" height="36" as="geometry"/></mxCell><mxCell id="pa-3" value="Each request sees contiguous logical blocks; a per-request block table maps them to physical blocks anywhere in GPU memory, allocated on demand. Block size here: 4 tokens (vLLM default: 16)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1560" height="40" as="geometry"/></mxCell><mxCell id="pa-4" value="① Logical view per request + block table" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=16;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fillColor=#f5f9fe;strokeColor=#6c8ebf;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="760" height="420" as="geometry"/></mxCell><mxCell id="pa-5" value="② Physical KV blocks in 