e:10px;color:#333333"&gt;7&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1429" y="400" width="24" height="32" as="geometry"/></mxCell><mxCell id="pd-79" value='&lt;span style="font-size:10px;color:#333333"&gt;8&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1453" y="400" width="24" height="32" as="geometry"/></mxCell><mxCell id="pd-80" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1367" y="400" as="sourcePoint"/><mxPoint x="1367" y="340" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pd-81" value="read" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1315" y="362" width="48" height="16" as="geometry"/></mxCell><mxCell id="pd-82" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1465" y="340" as="sourcePoint"/><mxPoint x="1465" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pd-83" value="append" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1469" y="362" width="50" height="16" as="geometry"/></mxCell><mxCell id="pd-84" value="⋯ until&lt;br&gt;&amp;lt;EOS&amp;gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1495" y="316" width="100" height="36" as="geometry"/></mxCell><mxCell id="pd-85" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;strokeColor=#d79b00;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="416" as="sourcePoint"/><mxPoint x="829" y="416" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pd-86" value="KV cache is kept and reused" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=10;fontColor=#9a6a00;" vertex="1" parent="1"><mxGeometry x="420" y="393" width="360" height="16" as="geometry"/></mxCell><mxCell id="pd-87" value="Each step &lt;b&gt;reads&lt;/b&gt; the K,V of all previous positions and &lt;b&gt;appends&lt;/b&gt; the new token's K,V in every layer — the cache grows by one entry per generated token." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="740" y="444" width="840" height="36" as="geometry"/></mxCell><mxCell id="pd-88" value="• &lt;b&gt;Memory-bandwidth-bound&lt;/b&gt;: every step reads all weights + the whole KV cache to produce 1 token per sequence&lt;br&gt;• &lt;b&gt;Sequential&lt;/b&gt; (autoregressive): step s+1 needs the token sampled at step s&lt;br&gt;• Repeats until &amp;lt;EOS&amp;gt; or max_tokens; sets &lt;b&gt;TPOT / ITL&lt;/b&gt; — time per output token&lt;br&gt;• Batching many sequences turns matrix × vector into matrix × matrix → better GPU use" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="740" y="490" width="840" height="80" as="geometry"/></mxCell><mxCell id="pd-89" value="③ Request timeline (one sequence)" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=16;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fillColor=#fafafa;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1560" height="250" as="geometry"/></mxCell><mxCell id="pd-90" value="Each green box = one decode step (one forward pass → one new token); tokens are streamed to the user as they are produced." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="700" y="626" width="890" height="20" as="geometry"/></mxCell><mxCell id="pd-91" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="790" as="sourcePoint"/><mxPoint x="1580" y="790" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pd-92" value="time" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1540" y="794" width="50" height="18" as="geometry"/></mxCell><mxCell id="pd-93" value="queue" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e6e6e6;strokeColor=#999999;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="70" y="730" width="80" height="50" as="geometry"/></mxCell><mxCell id="pd-94" value="&lt;b&gt;Prefill&lt;/b&gt;: whole prompt in 1 forward pass" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="150" y="730" width="400" height="50" as="geometry"/></mxCell><mxCell id="pd-95" value="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="556" y="730" width="44" height="50" as="geometry"/></mxCell><mxCell id="pd-96" value="2" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="606" y="730" width="44" height="50" as="geometry"/></mxCell><mxCell id="pd-97" value="3" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="656"