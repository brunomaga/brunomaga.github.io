 as="geometry"><mxPoint x="1020" y="844" as="sourcePoint"/><mxPoint x="1128" y="749" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pa-167" value="• The same block machinery powers beam search (shared prefixes across beams) and prefix caching across requests (page 5).&lt;br&gt;• When a request finishes, its blocks return to the free pool; under memory pressure requests can be preempted (blocks swapped to CPU or recomputed later)." style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="1560" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pc" name="5 · Prefix / prompt caching"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1050" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pc-2" value="Prefix (prompt) caching: reuse the KV cache of an identical prompt prefix" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1560" height="36" as="geometry"/></mxCell><mxCell id="pc-3" value="K and V at position i depend only on tokens 1…i, so requests that start with the same tokens can share the KV blocks of that prefix; only the new suffix needs prefill." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1560" height="40" as="geometry"/></mxCell><mxCell id="pc-4" value="① Three requests share a system prompt; two also share a document" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=16;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fillColor=#f5f9fe;strokeColor=#6c8ebf;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1560" height="230" as="geometry"/></mxCell><mxCell id="pc-5" value="&lt;b&gt;Req 1&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="146" width="60" height="36" as="geometry"/></mxCell><mxCell id="pc-6" value="System prompt · 1,000 tok" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="130" y="146" width="200" height="36" as="geometry"/></mxCell><mxCell id="pc-7" value="Document X · 3,000 tok" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="146" width="360" height="36" as="geometry"/></mxCell><mxCell id="pc-8" value="Q1 · 50 tok" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="690" y="146" width="100" height="36" as="geometry"/></mxCell><mxCell id="pc-9" value="prefill 4,050 tokens — cold cache; its KV blocks are kept" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="146" width="760" height="36" as="geometry"/></mxCell><mxCell id="pc-10" value="&lt;b&gt;Req 2&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="192" width="60" height="36" as="geometry"/></mxCell><mxCell id="pc-11" value="System prompt ✓ cached" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="130" y="192" width="200" height="36" as="geometry"/></mxCell><mxCell id="pc-12" value="Document X ✓ cached" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="330" y="192" width="360" height="36" as="geometry"/></mxCell><mxCell id="pc-13" value="Q2 · 50 tok" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="690" y="192" width="100" height="36" as="geometry"/></mxCell><mxCell id="pc-14" value="prefill only 50 tokens — 4,000 reused" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="192" width="760" height="36" as="geometry"/></mxCell><mxCell id="pc-15" value="&lt;b&gt;Req 3&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="238" width="60" height="36" as="geometry"/></mxCell><mxCell id="pc-16" value="System prompt ✓ cached" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="130" y="238" width="200" height="36" as="geometry"/></mxCell><mxCell id="pc-17" value="Document Y · 3,000 tok" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="238" width="360" height="36" as="geometry"/></mxCell><mxCell id="pc-18" value="Q3 · 50 tok" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="690" y="238" width="100" height="36" as="geometry"/></mxCell><mxCell id="pc-19" value="prefill 3,050 tokens — 1,000 reused (diverges at the document)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="238" width="760" height="36" as="geometry"/></mxCell><mxCell id="pc-20" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="130" y="294" width="18" height="18" as="geometry"/></mxCell><mxCell id="pc-21" value="computed by prefill" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="154" y="293" width="141" height="20" as="geometry"/></mxCell><mxCell id="pc-22" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="319" y="294" width="18" height="18" as="geometry"/></mxCell><mxCell id="pc-23" value="KV blocks reused from cache" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="343" y="293" width="197" height="20" as="geometry"/></mxCell><mxCell id="pc-24" value="② SGLang RadixAttention: a radix tree of cached prefixes" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=16;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fillColor=#fffaf3;strokeColor=#d79b00;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="760" height="380" as="geometry"/></mxCell><mxCell id="pc-25" value="root" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="515" width="60" height="40" as="geometry"/></mxCell><mxCell id="pc-26" value="System prompt" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="150" y="515" width="150" height="40" as="geometry"/></mxCell><mxCell id="pc-27" value="Document X" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="350" y="440" width="150" height="40" as="geometry"/></mxCell><mxCell id="pc-28" value="Document Y" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="350" y="590" width="150" height="40" as="geometry"/></mxCell><mxCell id="pc-29" value="Q1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="550" y="405" width="90" height="34" as="geometry"/></mxCell><mxCell id="pc-30" value="Q2" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="550" y="470" width="90" height="34" as="geometry"/></mxCell><mxCell id="pc-31" value="Q3" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="550" y="593" width="90" height="34" as="geometry"/></mxCell><mxCell id="pc-32" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pc-25" target="pc-26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pc-33" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pc-26" target="pc-27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pc-34" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pc-26" target="pc-28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pc-35" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pc-27" target="pc-29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pc-36" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pc-27" target="pc-30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pc-37" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pc-28" target="pc-31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pc-38" value="← Req 1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="650" y="405" width="120" height="34" as="geometry"/></mxCell><mxCell id="pc-39" value="← Req 2" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="650" y="470" width="120" height="34" as="geometry"/></mxCell><mxCell id="pc-40" value="← Req 3" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="650" y="593" width="120" height="34" as="geometry"/></mxCell><mxCell id="pc-41" value="Each node holds a token sequence and its KV blocks. A new request walks the tree to its longest cached prefix, prefills only the rest and adds it as a new branch. Nodes in use by running requests are pinned; unused leaves are evicted first (LRU)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="646" width="720" height="80" as="geometry"/></mxCell><mxCell id="pc-42" value="③ vLLM automatic prefix caching: hash chain over full blocks" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=16;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fillColor=#fffaf3;strokeColor=#d79b00;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="840" y="350" width="760" height="380" as="geometry"/></mxCell><mxCell id="pc-43" value="Prompt split into blocks of 16 tokens:" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="384" width="720" height="20" as="geometry"/></mxCell><mxCell id="pc-44" value="block 0 ✓" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="870" y="410" width="130" height="34" as="geometry"/></mxCell><mxCell id="pc-45" value="h&lt;sub&gt;0&lt;/sub&gt; = H(none, tokens&lt;sub&gt;0&lt;/sub&gt;)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="865" y="448" width="140" height="34" as="geometry"/></mxCell><mxCell id="pc-46" value="block 1 ✓" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1010" y="410" width="130" height="34" as="geometry"/></mxCell><mxCell id="pc-47" value="h&lt;sub&gt;1&lt;/sub&gt; = H(h&lt;sub&gt;0&lt;/sub&gt;, tokens&lt;sub&gt;1&lt;/sub&gt;)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1005" y="448" width="140" height="34" as="geometry"/></mxCell><mxCell id="pc-48" value="block 2 ✓" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1150" y="410" width="130" height="34" as="geometry"/></mxCell><mxCell id="pc-49" value="h&lt;sub&gt;2&lt;/sub&gt; = H(h&lt;sub&gt;1&lt;/sub&gt;, tokens&lt;sub&gt;2&lt;/sub&gt;)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1145" y="448" width="140" height="34" as="geometry"/></mxCell><mxCell id="pc-50" value="block 3 ✗" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1290" y="410" width="130" height="34" as="geometry"/></mxCell><mxCell id="pc-51" value="h&lt;sub&gt;3&lt;/sub&gt; = H(h&lt;sub&gt;2&lt;/sub&gt;, tokens&lt;sub&gt;3&lt;/sub&gt;)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1285" y="448" width="140" height="34" as="geometry"/></mxCell><mxCell id="pc-52" value="partial" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1"><mxGeometry x="1430" y="410" width="130" height="34" as="geometry"/></mxCell><mxCell id="pc-53" value="not cached&lt;br&gt;(not full)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1425" y="448" width="140" height="34" as="geometry"/></mxCell><mxCell id="pc-54" value="&lt;b&gt;hash table&lt;/b&gt; (hash → physical block)&lt;br&gt;h&lt;sub&gt;0&lt;/sub&gt; → block 12 ✓&lt;br&gt;h&lt;sub&gt;1&lt;/sub&gt; → block 3 ✓&lt;br&gt;h&lt;sub&gt;2&lt;/sub&gt; → block 27 ✓&lt;br&gt;h&lt;sub&gt;3&lt;/sub&gt; → not found ✗" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="870" y="520" width="250" height="120" as="geometry"/></mxCell><mxCell id="pc-55" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;entryX=0.5;entryY=0;" edge="1" parent="1" target="pc-54"><mxGeometry relative="1" as="geometry"><mxPoint x="995" y="484" as="sourcePoint"/></mxGeometry></mxCell><mxCell id="pc-56" value="look up in order" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1002" y="490" width="120" height="16" as="geometry"/></mxCell><mxCell id="pc-57" value="• A block's hash includes its parent's hash, so a hit means the whole prefix up to that block matches&lt;br&gt;• Lookup stops at the first miss: hit blocks are reused (ref count + 1); the rest is prefilled and added to the table&lt;br&gt;• Only full blocks are cached; the last partial block is always recomputed&lt;br&gt;• Freed blocks keep their contents until evicted (LRU), so later requests can still hit&lt;br&gt;• Extra keys such as the LoRA adapter or image hashes are mixed into the hash" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="500" width="450" height="225" as="geometry"/></mxCell><mxCell id="pc-58" value="④ Effect on Req 2: shorter prefill → lower TTFT and less compute" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=16;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fillColor=#fafafa;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="1560" height="270" as="geometry"/></mxCell><mxCell id="pc-59" value="&lt;b&gt;no prefix cache&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="812" width="160" height="40" as="geometry"/></mxCell><mxCell id="pc-60" value="prefill 4,050 tokens" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="230" y="812" width="600" height="40" as="geometry"/></mxCell><mxCell id="pc-61" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="834" y="812" width="30" height="40" as="geometry"/></mxCell><mxCell id="pc-62" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="868" y="812" width="30" height="40" as="geometry"/></mxCell><mxCell id="pc-63" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="902" y="812" width="30" height="40" as="geometry"/></mxCell><mxCell id="pc-64" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="936" y="812" width="30" height="40" as="geometry"/></mxCell><mxCell id="pc-65" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="970" y="812" width="30" height="40" as="geometry"/></mxCell><mxCell id="pc-66" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1004" y="812" width="30" height="40" as="geometry"/></mxCell><mxCell id="pc-67" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1038" y="812" width="30" height="40" as="geometry"/></mxCell><mxCell id="pc-68" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1072" y="812" width="30" height="40" as="geometry"/></mxCell><mxCell id="pc-69" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1106" y="812" width="30" height="40" as="geometry"/></mxCell><mxCell id="pc-70" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1140" y="812" width="30" height="40" as="geometry"/></mxCell><mxCell id="pc-71" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1;startArrow=block;startFill=1;strokeColor=#333333;endSize=5;startSize=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="230" y="800" as="sourcePoint"/><mxPoint x="830" y="800" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pc-72" value="TTFT" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="170" y="778" width="720" height="20" as="geometry"/></mxCell><mxCell id="pc-73" value="&lt;b&gt;with prefix cache&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="900" width="160" height="40" as="geometry"/></mxCell><mxCell id="pc-74" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="230" y="900" width="30" height="40" as="geometry"/></mxCell><mxCell id="pc-75" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="264" y="900" width="30" height="40" as="geometry"/></mxCell><mxCell id="pc-76" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="298" y="900" width="30" height="40" as="geometry"/></mxCell><mxCell id="pc-77" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="332" y="900" width="30" height="40" as="geometry"/></mxCell><mxCell id="pc-78" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="366" y="900" width="30" height="40" as="geometry"/></mxCell><mxCell id="pc-79" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="400" y="900" width="30" height="40" as="geometry"/></mxCell><mxCell id="pc-80" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="434" y="900" width="30" height="40" as="geometry"/></mxCell><mxCell id="pc-81" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="468" y="900" width="30" height="40" as="geometry"/></mxCell><mxCell id="pc-82" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="502" y="900" width="30" height="40" as="geometry"/></mxCell><mxCell id="pc-83" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="536" y="900" width="30" height="40" as="geometry"/></mxCell><mxCell id="pc-84" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="570" y="900" width="30" height="40" as="geometry"/></mxCell><mxCell id="pc-85" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1;startArrow=block;startFill=1;strokeColor=#333333;endSize=5;startSize=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="230" y="888" as="sourcePoint"/><mxPoint x="260" y="888" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pc-86" value="TTFT" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="170" y="866" width="150" height="20" as="geometry"/></mxCell><mxCell id="pc-87" value="prefill only 50 tokens (4,000 tokens' KV reused)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="230" y="944" width="400" height="18" as="geometry"/></mxCell><mxCell id="pc-88" value="Prefix caching only changes how much prefill is needed: the output is identical to running without the cache. Shared KV blocks are stored once, even when many requests use them." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="976" width="1100" height="36" as="geometry"/></mxCell><mxCell id="pc-89" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="640" y="912" width="14" height="14" as="geometry"/></mxCell><mxCell id="pc-90" value="prefill" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="911" width="57" height="16" as="geometry"/></mxCell><mxCell id="pc-91" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="733" y="912" width="14" height="14" as="geometry"/></mxCell><mxCell id="pc-92" value="decode steps" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="753" y="911" width="92" height="16" as="geometry"/></mxCell><mxCell id="pc-93" value="• &lt;b&gt;Exact match from the first token&lt;/b&gt;: one different token early on (e.g. a timestamp in the system prompt) invalidates everything after it&lt;br&gt;• Put static content first (system prompt, tool definitions, documents), variable content last&lt;br&gt;• Hosted APIs offer the same idea as “prompt caching”: cached input tokens are cheaper and faster, and entries expire after a short TTL" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1200" y="790" width="380" height="180" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="sc" name="6 · Semantic caching"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1090" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sc-2" value="Semantic caching: reuse a stored answer when a new query means the same thing" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1560" height="36" as="geometry"/></mxCell><mxCell id="sc-3" value="An application-level cache in front of the model. Keys are embeddings; lookup is a nearest-neighbour search with a similarity threshold. A hit skips the LLM call entirely." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1560" height="40" as="geometry"/></mxCell><mxCell id="sc-4" value="① Request flow" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=16;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fillColor=#f3fbfb;strokeColor=#2a9d8f;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1560" height="400" as="geometry"/></mxCell><mxCell id="sc-5" value="&lt;b&gt;User query&lt;/b&gt;&lt;br&gt;&lt;i&gt;“I forgot my password, how can I change it?”&lt;/i&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="190" height="90" as="geometry"/></mxCell><mxCell id="sc-6" value="&lt;b&gt;Embedding model&lt;/b&gt;&lt;br&gt;query → vector e" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="300" y="225" width="150" height="60" as="geometry"/></mxCell><mxCell id="sc-7" value="&lt;b&gt;Semantic cache&lt;/b&gt;&lt;br&gt;vector index of&lt;br&gt;(embedding, query, response)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530" y="190" width="200" height="130" as="geometry"/></mxCell><mxCell id="sc-8" value='similarity ≥ threshold?&lt;br&gt;&lt;span style="font-size:11px;color:#333333"&gt;(e.g. cosine ≥ 0.9)&lt;/span&gt;' style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="200" width="200" height="110" as="geometry"/></mxCell><mxCell id="sc-9" value='&lt;b&gt;Return cached response&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#2d7a2d"&gt;≈ milliseconds, no LLM call&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1090" y="140" width="200" height="56" as="geometry"/></mxCell><mxCell id="sc-10" value='&lt;b&gt;Call the LLM&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#333333"&gt;prefill + decode: full cost&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1090" y="330" width="200" height="60" as="geometry"/></mxCell><mxCell id="sc-11" value="&lt;b&gt;Response to user&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1380" y="225" width="190" height="60" as="geometry"/></mxCell><mxCell id="sc-12" value='&lt;b&gt;Store&lt;/b&gt; (e, query, response)&lt;br&gt;&lt;span style="font-size:11px;color:#333333"&gt;+ TTL, scope (user / tenant)&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1090" y="420" width="200" height="56" as="geometry"/></mxCell><mxCell id="sc-13" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="sc-5" target="sc-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sc-14" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="sc-6" target="sc-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sc-15" value="search" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="450" y="232" width="80" height="16" as="geometry"/></mxCell><mxCell id="sc-16" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="sc-7" target="sc-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sc-17" value="top-1 match" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="730" y="232" width="80" height="16" as="geometry"/></mxCell><mxCell id="sc-18" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="sc-8" target="sc-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sc-19" value="&lt;b&gt;yes → HIT&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#2d7a2d;" vertex="1" parent="1"><mxGeometry x="930" y="144" width="140" height="16" as="geometry"/></mxCell><mxCell id="sc-20" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="sc-8" target="sc-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sc-21" value="&lt;b&gt;no → MISS&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="930" y="336" width="140" height="16" as="geometry"/></mxCell><mxCell id="sc-22" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="sc-9" target="sc-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sc-23" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.7;" edge="1" parent="1" source="sc-10" target="sc-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sc-24" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sc-10" target="sc-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sc-25" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="sc-12" target="sc-7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="630" y="448"/></Array></mxGeometry></mxCell><mxCell id="sc-26" value="add entry" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="800" y="425" width="120" height="16" as="geometry"/></mxCell><mxCell id="sc-27" value="Examples: GPTCache, RedisVL SemanticCache, LLM gateways with a semantic-cache option. An exact-match cache (hash of the full prompt) is the lossless special case." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="520" height="80" as="geometry"/></mxCell><mxCell id="sc-28" value="② Example lookups (similarity values are illustrative)" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=16;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fillColor=#fafafa;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="1560" height="230" as="geometry"/></mxCell><mxCell id="sc-29" value="Cached query" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e6e6e6;strokeColor=#999999;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="556" width="330" height="28" as="geometry"/></mxCell><mxCell id="sc-30" value="New query" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e6e6e6;strokeColor=#999999;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="390" y="556" width="380" height="28" as="geometry"/></mxCell><mxCell id="sc-31" value="Similarity" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e6e6e6;strokeColor=#999999;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="770" y="556" width="110" height="28" as="geometry"/></mxCell><mxCell id="sc-32" value="Outcome" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e6e6e6;strokeColor=#999999;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="556" width="560" height="28" as="geometry"/></mxCell><mxCell id="sc-33" value="“How do I reset my password?”" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="584" width="330" height="38" as="geometry"/></mxCell><mxCell id="sc-34" value="“I forgot my password, how can I change it?”" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="390" y="584" width="380" height="38" as="geometry"/></mxCell><mxCell id="sc-35" value="0.93" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="770" y="584" width="110" height="38" as="geometry"/></mxCell><mxCell id="sc-36" value="✓ HIT — same intent, cached answer reused" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="880" y="584" width="560" height="38" as="geometry"/></mxCell><mxCell id="sc-37" value="“How do I reset my password?”" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="622" width="330" height="38" as="geometry"/></mxCell><mxCell id="sc-38" value="“How do I reset my router?”" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="390" y="622" width="380" height="38" as="geometry"/></mxCell><mxCell id="sc-39" value="0.81" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="770" y="622" width="110" height="38" as="geometry"/></mxCell><mxCell id="sc-40" value="✓ MISS — different intent, LLM is called" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="880" y="622" width="560" height="38" as="geometry"/></mxCell><mxCell id="sc-41" value="“What's the weather in Paris today?”" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="660" width="330" height="38" as="geometry"/></mxCell><mxCell id="sc-42" value="“What's the weather in Paris tomorrow?”" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="390" y="660" width="380" height="38" as="geometry"/></mxCell><mxCell id="sc-43" value="0.96" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="770" y="660" width="110" height="38" as="geometry"/></mxCell><mxCell id="sc-44" value="✗ false HIT — returns the answer for the wrong day" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="880" y="660" width="560" height="38" as="geometry"/></mxCell><mxCell id="sc-45" value="The threshold trades hit rate against wrong answers: too low → false hits, too high → few hits. Time-sensitive or personalised queries should bypass the cache." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="706" width="1500" height="36" as="geometry"/></mxCell><mxCell id="sc-46" value="③ Prefix caching vs semantic caching" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=16;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fillColor=#fafafa;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="1560" height="290" as="geometry"/></mxCell><mxCell id="sc-47" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e6e6e6;strokeColor=#999999;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="806" width="200" height="28" as="geometry"/></mxCell><mxCell id="sc-48" value="Prefix (KV) caching — page 5" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e6e6e6;strokeColor=#999999;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="806" width="640" height="28" as="geometry"/></mxCell><mxCell id="sc-49" value="Semantic caching" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e6e6e6;strokeColor=#999999;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="806" width="680" height="28" as="geometry"/></mxCell><mxCell id="sc-50" value="&lt;b&gt;Where it runs&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="834" width="200" height="34" as="geometry"/></mxCell><mxCell id="sc-51" value="inside the inference engine (vLLM, SGLang, …) or the provider API" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="260" y="834" width="640" height="34" as="geometry"/></mxCell><mxCell id="sc-52" value="in front of the model (application or gateway)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="900" y="834" width="680" height="34" as="geometry"/></mxCell><mxCell id="sc-53" value="&lt;b&gt;Match&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="868" width="200" height="34" as="geometry"/></mxCell><mxCell id="sc-54" value="exact token prefix" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="260" y="868" width="640" height="34" as="geometry"/></mxCell><mxCell id="sc-55" value="similar meaning (embedding similarity ≥ threshold)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="900" y="868" width="680" height="34" as="geometry"/></mxCell><mxCell id="sc-56" value="&lt;b&gt;What is reused&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="902" width="200" height="34" as="geometry"/></mxCell><mxCell id="sc-57" value="KV cache of the shared prefix" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="260" y="902" width="640" height="34" as="geometry"/></mxCell><mxCell id="sc-58" value="the final response text" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="900" y="902" width="680" height="34" as="geometry"/></mxCell><mxCell id="sc-59" value="&lt;b&gt;On a hit&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="936" width="200" height="34" as="geometry"/></mxCell><mxCell id="sc-60" value="suffix prefill + full decode still run" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="260" y="936" width="640" height="34" as="geometry"/></mxCell><mxCell id="sc-61" value="no LLM call at all (milliseconds)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="900" y="936" width="680" height="34" as="geometry"/></mxCell><mxCell id="sc-62" value="&lt;b&gt;Output&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="970" width="200" height="34" as="geometry"/></mxCell><mxCell id="sc-63" value="identical to no caching (lossless)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="260" y="970" width="640" height="34" as="geometry"/></mxCell><mxCell id="sc-64" value="can be wrong or stale (lossy)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="900" y="970" width="680" height="34" as="geometry"/></mxCell><mxCell id="sc-65" value="&lt;b&gt;Main knobs&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="1004" width="200" height="34" as="geometry"/></mxCell><mxCell id="sc-66" value="memory for cached blocks, eviction (LRU)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="260" y="1004" width="640" height="34" as="geometry"/></mxCell><mxCell id="sc-67" value="threshold, TTL, scope (per user / tenant), what not to cache" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="900" y="1004" width="680" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="rb" name="7 · Ragged / packed batching"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="950" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="rb-2" value="Ragged (packed) batching: concatenate variable-length sequences instead of padding" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1560" height="36" as="geometry"/></mxCell><mxCell id="rb-3" value="Token-wise layers (QKV projections, MLP) run on one flat [total_tokens × d] matrix; attention uses the sequence offsets (cu_seqlens) so tokens only attend within their own sequence." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1560" height="40" as="geometry"/></mxCell><mxCell id="rb-4" value="① Padded batch: [batch × max_len]" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=16;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fillColor=#fdf5f5;strokeColor=#b85450;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="600" height="330" as="geometry"/></mxCell><mxCell id="rb-5" value="&lt;b&gt;A&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="150" width="40" height="40" as="geometry"/></mxCell><mxCell id="rb-6" value="A1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="120" y="150" width="72" height="40" as="geometry"/></mxCell><mxCell id="rb-7" value="A2" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="192" y="150" width="72" height="40" as="geometry"/></mxCell><mxCell id="rb-8" value="A3" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="264" y="150" width="72" height="40" as="geometry"/></mxCell><mxCell id="rb-9" value="A4" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="336" y="150" width="72" height="40" as="geometry"/></mxCell><mxCell id="rb-10" value="A5" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="408" y="150" width="72" height="40" as="geometry"/></mxCell><mxCell id="rb-11" value="pad" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#eeeeee;strokeColor=#bbbbbb;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="480" y="150" width="72" height="40" as="geometry"/></mxCell><mxCell id="rb-12" value="&lt;b&gt;B&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="198" width="40" height="40" as="geometry"/></mxCell><mxCell id="rb-13" value="B1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d0f0ef;strokeColor=#2a9d8f;" vertex="1" parent="1"><mxGeometry x="120" y="198" width="72" height="40" as="geometry"/></mxCell><mxCell id="rb-14" value="B2" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d0f0ef;strokeColor=#2a9d8f;" vertex="1" parent="1"><mxGeometry x="192" y="198" width="72" height="40" as="geometry"/></mxCell><mxCell id="rb-15" value="pad" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#eeeeee;strokeColor=#bbbbbb;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="264" y="198" width="72" height="40" as="geometry"/></mxCell><mxCell id="rb-16" value="pad" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#eeeeee;strokeColor=#bbbbbb;fontColor=#999999;" vertex="1" parent="