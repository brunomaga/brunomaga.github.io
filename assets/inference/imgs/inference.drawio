ter;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="471" width="200" height="16" as="geometry"/></mxCell><mxCell id="kv-48" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;entryX=0.5;entryY=0;" edge="1" parent="1" target="kv-45"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="210" as="sourcePoint"/></mxGeometry></mxCell><mxCell id="kv-49" value="o&lt;sub&gt;t&lt;/sub&gt; (1×d&lt;sub&gt;h&lt;/sub&gt;)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1290" y="474" width="110" height="40" as="geometry"/></mxCell><mxCell id="kv-50" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="kv-45" target="kv-49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="kv-51" value="→ concat heads · W&lt;sub&gt;O&lt;/sub&gt;&lt;br&gt;→ MLP → next layer" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1410" y="472" width="180" height="44" as="geometry"/></mxCell><mxCell id="kv-52" value="Cost of this step for one head:&lt;br&gt;• q·K&lt;sup&gt;T&lt;/sup&gt;: t dot products&lt;br&gt;• a·V: weighted sum of t rows&lt;br&gt;→ reads the whole cache, little math" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1290" y="250" width="300" height="100" as="geometry"/></mxCell><mxCell id="kv-53" value="Only x&lt;sub&gt;t&lt;/sub&gt; is multiplied by W&lt;sub&gt;Q&lt;/sub&gt;, W&lt;sub&gt;K&lt;/sub&gt;, W&lt;sub&gt;V&lt;/sub&gt;; keys and values of positions 1…t−1 come from the cache. Queries are not cached: q&lt;sub&gt;t&lt;/sub&gt; is only needed in this step." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="578" width="1520" height="36" as="geometry"/></mxCell><mxCell id="kv-54" value="Why cache? Work per decode step" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=16;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fillColor=#fafafa;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="760" height="390" as="geometry"/></mxCell><mxCell id="kv-55" value="&lt;b&gt;Without KV cache&lt;/b&gt; — every step re-runs the whole sequence" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="676" width="720" height="20" as="geometry"/></mxCell><mxCell id="kv-56" value="step 1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="704" width="70" height="28" as="geometry"/></mxCell><mxCell id="kv-57" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="140" y="704" width="26" height="28" as="geometry"/></mxCell><mxCell id="kv-58" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="166" y="704" width="26" height="28" as="geometry"/></mxCell><mxCell id="kv-59" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="192" y="704" width="26" height="28" as="geometry"/></mxCell><mxCell id="kv-60" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="218" y="704" width="26" height="28" as="geometry"/></mxCell><mxCell id="kv-61" value="" 