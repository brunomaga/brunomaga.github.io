4" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.2;endSize=5;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1386" y="554" as="sourcePoint"/><mxPoint x="1386" y="578" as="targetPoint"/></mxGeometry></mxCell><mxCell id="rb-375" value="8" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1366" y="536" width="40" height="16" as="geometry"/></mxCell><mxCell id="rb-376" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.2;endSize=5;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1438" y="554" as="sourcePoint"/><mxPoint x="1438" y="578" as="targetPoint"/></mxGeometry></mxCell><mxCell id="rb-377" value="9" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1418" y="536" width="40" height="16" as="geometry"/></mxCell><mxCell id="rb-378" value="prefill segment (6 tokens):&lt;br&gt;causal attention within E" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="970" y="626" width="312" height="50" as="geometry"/></mxCell><mxCell id="rb-379" value="A's KV cache&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555&quot;&gt;(paged blocks)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1250" y="730" width="105" height="46" as="geometry"/></mxCell><mxCell id="rb-380" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.2;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1308" y="620" as="sourcePoint"/><mxPoint x="1302" y="730" as="targetPoint"/></mxGeometry></mxCell><mxCell id="rb-381" value="B's KV cache&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555&quot;&gt;(paged blocks)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1365" y="730" width="105" height="46" as="geometry"/></mxCell><mxCell id="rb-382" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.2;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1360" y="620" as="sourcePoint"/><mxPoint x="1417" y="730" as="targetPoint"/></mxGeometry></mxCell><mxCell id="rb-383" value="C's KV cache&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555&quot;&gt;(paged blocks)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1480" y="730" width="105" height="46" as="geometry"/></mxCell><mxCell id="rb-384" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.2;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1412" y="620" as="sourcePoint"/><mxPoint x="1532" y="730" as="targetPoint"/></mxGeometry></mxCell><mxCell id="rb-385" value="each decode query attends over its own request's cached K,V" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1250" y="784" width="340" height="36" as="geometry"/></mxCell><mxCell id="rb-386" value="cu_seqlens&amp;nbsp;=&amp;nbsp;[0,&amp;nbsp;6,&amp;nbsp;7,&amp;nbsp;8,&amp;nbsp;9]" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="970" y="694" width="260" height="22" as="geometry"/></mxCell><mxCell id="rb-387" value="A decode step is just a segment of length 1 whose keys and values come from the KV cache. Packing prompt chunks and decode tokens of many requests into every forward pass is &lt;b&gt;continuous (iteration-level) batching&lt;/b&gt;: finished requests leave and new ones join at every iteration, without waiting for the whole batch → page 8." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="830" width="620" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="cp" name="8 · Mixed batching + chunked prefill"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1070" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cp-2" value="Mixed prefill/decode batching with chunked prefill" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1560" height="36" as="geometry"/></mxCell><mxCell id="cp-3" value="Every engine iteration has a token budget. Running decodes (1 token each) go in first; the rest is filled with a chunk of a waiting prompt, so a long prompt is spread over several iterations instead of stalling everyone else." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1560" height="40" as="geometry"/></mxCell><mxCell id="cp-4" value="① Without chunking: prefill-first scheduling" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=16;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fillColor=#fdf5f5;strokeColor=#b85450;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1560" height="300" as="geometry"/></mxCell><mxCell id="cp-5" value="&lt;b&gt;A&lt;/b&gt; (decoding)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="190" height="36" as="geometry"/></mxCell><mxCell id="cp-6" value="&lt;b&gt;B&lt;/b&gt; (decoding)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="226" width="190" height="36" as="geometry"/></mxCell><mxCell id="cp-7" value="&lt;b&gt;C&lt;/b&gt; (new: 1,530-token prompt)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="272" width="190" height="36" as="geometry"/></mxCell><mxCell id="cp-8" value="it 1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=10;" vertex="1" parent="1"><mxGeometry x="250" y="146" width="80" height="30" as="geometry"/></mxCell><mxCell id="cp-9" value="A" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="260" y="180" width="60" height="36" as="geometry"/></mxCell><mxCell id="cp-10" value="B" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="260" y="226" width="60" height="36" as="geometry"/></mxCell><mxCell id="cp-11" value="waiting" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#eeeeee;strokeColor=#bbbbbb;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="260" y="272" width="60" height="36" as="geometry"/></mxCell><mxCell id="cp-12" value="it 2 · prefill-only batch (1,530 tokens)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=10;" vertex="1" parent="1"><mxGeometry x="314" y="146" width="350" height="30" as="geometry"/></mxCell><mxCell id="cp-13" value="no token: stalled" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="324" y="180" width="330" height="36" as="geometry"/></mxCell><mxCell id="cp-14" value="no token: stalled" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="324" y="226" width="330" height="36" as="geometry"/></mxCell><mxCell id="cp-15" value="prefill C: all 1,530 prompt tokens" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="324" y="272" width="330" height="36" as="geometry"/></mxCell><mxCell id="cp-16" value="it 3" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=10;" vertex="1" parent="1"><mxGeometry x="648" y="146" width="80" height="30" as="geometry"/></mxCell><mxCell id="cp-17" value="A" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="658" y="180" width="60" height="36" as="geometry"/></mxCell><mxCell id="cp-18" value="B" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="658" y="226" width="60" height="36" as="geometry"/></mxCell><mxCell id="cp-19" value="C" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="658" y="272" width="60" height="36" as="geometry"/></mxCell><mxCell id="cp-20" value="it 4" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=10;" vertex="1" parent="1"><mxGeometry x="712" y="146" width="80" height="30" as="geometry"/></mxCell><mxCell id="cp-21" value="A" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="722" y="180" width="60" height="36" as="geometry"/></mxCell><mxCell id="cp-22" value="B" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="722" y="226" width="60" height="36" as="geometry"/></mxCell><mxCell id="cp-23" value="C" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="722" y="272" width="60" height="36" as="geometry"/></mxCell><mxCell id="cp-24" value="it 5" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=10;" vertex="1" parent="1"><mxGeometry x="776" y="146" width="80" height="30" as="geometry"/></mxCell><mxCell id="cp-25" value="A" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="786" y="180" width="60" height="36" as="geometry"/></mxCell><mxCell id="cp-26" value="B" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="786" y="226" width="60" height="36" as="geometry"/></mxCell><mxCell id="cp-27" value="C" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="786" y="272" width="60" height="36" as="geometry"/></mxCell><mxCell id="cp-28" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260" y="322" as="sourcePoint"/><mxPoint x="886" y="322" as="targetPoint"/></mxGeometry></mxCell><mxCell id="cp-29" value="time" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="850" y="324" width="36" height="16" as="geometry"/></mxCell><mxCell id="cp-30" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1;startArrow=block;startFill=1;strokeColor=#b85450;endSize=5;startSize=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="320" y="352" as="sourcePoint"/><mxPoint x="718" y="352" as="targetPoint"/></mxGeometry></mxCell><mxCell id="cp-31" value="A's gap between two tokens: long ITL" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="260" y="330" width="518" height="20" as="geometry"/></mxCell><mxCell id="cp-32" value="• A and B produce no token during iteration 2 → inter-token latency spike (“generation stall”)&lt;br&gt;• The longer the new prompt, the longer the stall&lt;br&gt;• Decode-only iterations (1, 3, 4, 5) are memory-bound: most of the GPU's compute sits idle" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="940" y="174" width="640" height="100" as="geometry"/></mxCell><mxCell id="cp-33" value="② With chunked prefill: mixed batches, token budget = 512 tokens per iteration" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=16;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fillColor=#f6fbf4;strokeColor=#82b366;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="1560" height="300" as="geometry"/></mxCell><mxCell id="cp-34" value="&lt;b&gt;A&lt;/b&gt; (decoding)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="190" height="36" as="geometry"/></mxCell><mxCell id="cp-35" value="&lt;b&gt;B&lt;/b&gt; (decoding)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="546" width="190" height="36" as="geometry"/></mxCell><mxCell id="cp-36" value="&lt;b&gt;C&lt;/b&gt; (new: 1,530-token prompt)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="592" width="190" height="36" as="geometry"/></mxCell><mxCell id="cp-37" value="it 1&lt;br&gt;2 tok" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=10;" vertex="1" parent="1"><mxGeometry x="250" y="466" width="80" height="30" as="geometry"/></mxCell><mxCell id="cp-38" value="A" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="260" y="500" width="60" height="36" as="geometry"/></mxCell><mxCell id="cp-39" value="B" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="260" y="546" width="60" height="36" as="geometry"/></mxCell><mxCell id="cp-40" value="waiting" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#eeeeee;strokeColor=#bbbbbb;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="260" y="592" width="60" height="36" as="geometry"/></mxCell><mxCell id="cp-41" value="it 2&lt;br&gt;2 + 510 tok" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=10;" vertex="1" parent="1"><mxGeometry x="314" y="466" width="130" height="30" as="geometry"/></mxCell><mxCell id="cp-42" value="A" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="324" y="500" width="110" height="36" as="geometry"/></mxCell><mxCell id="cp-43" value="B" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="324" y="546" width="110" height="36" as="geometry"/></mxCell><mxCell id="cp-44" value="C: tokens 1–510" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="324" y="592" width="110" height="36" as="geometry"/></mxCell><mxCell id="cp-45" value="it 3&lt;br&gt;2 + 510 tok" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=10;" vertex="1" parent="1"><mxGeometry x="428" y="466" width="130" height="30" as="geometry"/></mxCell><mxCell id="cp-46" value="A" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="438" y="500" width="110" height="36" as="geometry"/></mxCell><mxCell id="cp-47" value="B" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="438" y="546" width="110" height="36" as="geometry"/></mxCell><mxCell id="cp-48" value="C: 511–1,020" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="438" y="592" width="110" height="36" as="geometry"/></mxCell><mxCell id="cp-49" value="it 4&lt;br&gt;2 + 510 tok" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=10;" vertex="1" parent="1"><mxGeometry x="542" y="466" width="130" height="30" as="geometry"/></mxCell><mxCell id="cp-50" value="A" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="552" y="500" width="110" height="36" as="geometry"/></mxCell><mxCell id="cp-51" value="B" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="552" y="546" width="110" height="36" as="geometry"/></mxCell><mxCell id="cp-52" value="C: 1,021–1,530&lt;br&gt;→ 1st token" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="552" y="592" width="110" height="36" as="geometry"/></mxCell><mxCell id="cp-53" value="it 5&lt;br&gt;3 tok" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=10;" vertex="1" parent="1"><mxGeometry x="656" y="466" width="80" height="30" as="geometry"/></mxCell><mxCell id="cp-54" value="A" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="666" y="500" width="60" height="36" as="geometry"/></mxCell><mxCell id="cp-55" value="B" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="666" y="546" width="60" height="36" as="geometry"/></mxCell><mxCell id="cp-56" value="C" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="666" y="592" width="60" height="36" as="geometry"/></mxCell><mxCell id="cp-57" value="it 6&lt;br&gt;3 tok" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=10;" vertex="1" parent="1"><mxGeometry x="720" y="466" width="80" height="30" as="geometry"/></mxCell><mxCell id="cp-58" value="A" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="730" y="500" width="60" height="36" as="geometry"/></mxCell><mxCell id="cp-59" value="B" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="730" y="546" width="60" height="36" as="geometry"/></mxCell><mxCell id="cp-60" value="C" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="730" y="592" width="60" height="36" as="geometry"/></mxCell><mxCell id="cp-61" value="it 7&lt;br&gt;3 tok" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=10;" vertex="1" parent="1"><mxGeometry x="784" y="466" width="80" height="30" as="geometry"/></mxCell><mxCell id="cp-62" value="A" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="794" y="500" width="60" height="36" as="geometry"/></mxCell><mxCell id="cp-63" value="B" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="794" y="546" width="60" height="36" as="geometry"/></mxCell><mxCell id="cp-64" value="C" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="794" y="592" width="60" height="36" as="geometry"/></mxCell><mxCell id="cp-65" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260" y="642" as="sourcePoint"/><mxPoint x="894" y="642" as="targetPoint"/></mxGeometry></mxCell><mxCell id="cp-66" value="time" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="858" y="644" width="36" height="16" as="geometry"/></mxCell><mxCell id="cp-67" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1;startArrow=block;startFill=1;strokeColor=#2d7a2d;endSize=5;startSize=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="320" y="672" as="sourcePoint"/><mxPoint x="434" y="672" as="targetPoint"/></mxGeometry></mxCell><mxCell id="cp-68" value="ITL bounded by one iteration" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#2d7a2d;" vertex="1" parent="1"><mxGeometry x="260" y="650" width="234" height="20" as="geometry"/></mxCell><mxCell id="cp-69" value="• Every iteration still emits a token for A and B → smooth, bounded inter-token latency&lt;br&gt;• The prompt chunk shares the forward pass with the decodes: weights are read once for both, so the decode tokens ride along almost for free and the GPU stays busy&lt;br&gt;• C's TTFT grows a little: its prompt is spread over 3 iterations" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="940" y="494" width="640" height="100" as="geometry"/></mxCell><mxCell id="cp-70" value="③ Inside iteration 3: one packed forward pass" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=16;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fillColor=#f5f9fe;strokeColor=#6c8ebf;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="760" height="300" as="geometry"/></mxCell><mxCell id="cp-71" value="a" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="70" y="820" width="50" height="40" as="geometry"/></mxCell><mxCell id="cp-72" value="b" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="120" y="820" width="50" height="40" as="geometry"/></mxCell><mxCell id="cp-73" value="C: prompt tokens 511–1,020 (510 tokens)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="170" y="820" width="600" height="40" as="geometry"/></mxCell><mxCell id="cp-74" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.2;endSize=5;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="794" as="sourcePoint"/><mxPoint x="70" y="818" as="targetPoint"/></mxGeometry></mxCell><mxCell id="cp-75" value="0" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="776" width="40" height="16" as="geometry"/></mxCell><mxCell id="cp-76" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.2;endSize=5;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="794" as="sourcePoint"/><mxPoint x="120" y="818" as="targetPoint"/></mxGeometry></mxCell><mxCell id="cp-77" value="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="776" width="40" height="16" as="geometry"/></mxCell><mxCell id="cp-78" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.2;endSize=5;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="794" as="sourcePoint"/><mxPoint x="170" y="818" as="targetPoint"/></mxGeometry></mxCell><mxCell id="cp-79" value="2" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="150" y="776" width="40" height="16" as="geometry"/></mxCell><mxCell id="cp-80" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.2;endSize=5;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="770" y="794" as="sourcePoint"/><mxPoint x="770" y="818" as="targetPoint"/></mxGeometry></mxCell><mxCell id="cp-81" value="512" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="750" y="776" width="40" height="16" as="geometry"/></mxCell><mxCell id="cp-82" value="cu_seqlens&amp;nbsp;=&amp;nbsp;[0,&amp;nbsp;1,&amp;nbsp;2,&amp;nbsp;512]&amp;nbsp;&amp;nbsp;&amp;nbsp;(512&amp;nbsp;tokens&amp;nbsp;=&amp;nbsp;the&amp;nbsp;budget)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="70" y="866" width="700" height="20" as="geometry"/></mxCell><mxCell id="cp-83" value="&lt;b&gt;QKV / MLP&lt;/b&gt;: one GEMM over all 512 tokens — the weights are read from HBM once for all three requests" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="70" y="892" width="700" height="44" as="geometry"/></mxCell><mxCell id="cp-84" value="• &lt;b&gt;a&lt;/b&gt;: 1 query → A's cached K,V (paged)&lt;br&gt;• &lt;b&gt;b&lt;/b&gt;: 1 query → B's cached K,V&lt;br&gt;• &lt;b&gt;C chunk&lt;/b&gt;: 510 queries → K,V of tokens 1–510 (already in C's cache) + causal within the chunk; the new K,V are appended to C's cache" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="944" width="710" height="90" as="geometry"/></mxCell><mxCell id="cp-85" value="④ Scheduler, once per iteration" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=16;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fillColor=#fafafa;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="840" y="740" width="760" height="300" as="geometry"/></mxCell><mxCell id="cp-86" value="budget&amp;nbsp;=&amp;nbsp;max_num_batched_tokens&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;#&amp;nbsp;e.g.&amp;nbsp;512&lt;br&gt;batch&amp;nbsp;=&amp;nbsp;[]&lt;br&gt;for&amp;nbsp;req&amp;nbsp;in&amp;nbsp;running:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;#&amp;nbsp;1)&amp;nbsp;decodes&amp;nbsp;first:&amp;nbsp;1&amp;nbsp;token&amp;nbsp;each&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;batch.add(req,&amp;nbsp;1);&amp;nbsp;budget&amp;nbsp;-=&amp;nbsp;1&lt;br&gt;for&amp;nbsp;req&amp;nbsp;in&amp;nbsp;waiting:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;#&amp;nbsp;2)&amp;nbsp;fill&amp;nbsp;the&amp;nbsp;rest&amp;nbsp;with&amp;nbsp;prompt&amp;nbsp;chunks&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;n&amp;nbsp;=&amp;nbsp;min(budget,&amp;nbsp;req.prompt_tokens_left)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if&amp;nbsp;n&amp;nbsp;==&amp;nbsp;0:&amp;nbsp;break&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;batch.add(req,&amp;nbsp;n);&amp;nbsp;budget&amp;nbsp;-=&amp;nbsp;n&lt;br&gt;model.forward(batch)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;#&amp;nbsp;one&amp;nbsp;packed&amp;nbsp;forward&amp;nbsp;pass" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="860" y="776" width="720" height="160" as="geometry"/></mxCell><mxCell id="cp-87" value="• Smaller budget → lower ITL, but more iterations per prompt (each chunk re-reads the K,V of earlier chunks); larger budget → higher throughput&lt;br&gt;• vLLM: --enable-chunked-prefill, --max-num-batched-tokens · SGLang: --chunked-prefill-size&lt;br&gt;• Alternative: disaggregated serving — prefill and decode on separate GPUs, with the KV cache transferred between them" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="946" width="720" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>