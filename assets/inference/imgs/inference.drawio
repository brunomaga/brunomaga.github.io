0;" vertex="1" parent="1"><mxGeometry x="166" y="950" width="26" height="28" as="geometry"/></mxCell><mxCell id="kv-105" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="192" y="950" width="26" height="28" as="geometry"/></mxCell><mxCell id="kv-106" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="218" y="950" width="26" height="28" as="geometry"/></mxCell><mxCell id="kv-107" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="244" y="950" width="26" height="28" as="geometry"/></mxCell><mxCell id="kv-108" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="270" y="950" width="26" height="28" as="geometry"/></mxCell><mxCell id="kv-109" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="296" y="950" width="26" height="28" as="geometry"/></mxCell><mxCell id="kv-110" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="322" y="950" width="26" height="28" as="geometry"/></mxCell><mxCell id="kv-111" value="1 token computed, 7 cached K,V read" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="950" width="400" height="28" as="geometry"/></mxCell><mxCell id="kv-112" value="→ projections and MLP: constant work per step; attention still reads all t cached K,V every step (memory traffic grows with t)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#2d7a2d;" vertex="1" parent="1"><mxGeometry x="60" y="986" width="720" height="36" as="geometry"/></mxCell><mxCell id="kv-113" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="500" y="676" width="14" height="14" as="geometry"/></mxCell><mxCell id="kv-114" value="computed" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="675" width="64" height="16" as="geometry"/></mxCell><mxCell id="kv-115" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="600" y="676" width="14" height="14" as="geometry"/></mxCell><mxCell id="kv-116" value="read from cache" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="675" width="113" height="16" as="geometry"/></mxCell><mxCell id="kv-117" value="How big is it?" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=16;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fillColor=#fafafa;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="840" y="640" width="760" height="390" as="geometry"/></mxCell><mxCell id="kv-118" value="Shape: [layers, 2 (K and V), batch, kv_heads, seq_len, head_dim]&lt;br&gt;&lt;b&gt;Bytes = 2 × layers × kv_heads × head_dim × bytes/elem × seq_len × batch&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="676" width="720" height="50" as="geometry"/></mxCell><mxCell id="kv-119" value="&lt;b&gt;Model (FP16 KV cache)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e6e6e6;strokeColor=#999999;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="860" y="750" width="330" height="28" as="geometry"/></mxCell><mxCell id="kv-120" value="&lt;b&gt;per token&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e6e6e6;strokeColor=#999999;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1190" y="750" width="140" height="28" as="geometry"/></mxCell><mxCell id="kv-121" value="&lt;b&gt;one sequence&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e6e6e6;strokeColor=#999999;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1330" y="750" width="230" height="28" as="geometry"/></mxCell><mxCell id="kv-122" value='&lt;b&gt;Llama-2-7B&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555"&gt;32 layers · 32 KV heads (MHA) · head_dim 128&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="860" y="778" width="330" height="48" as="geometry"/></mxCell><mxCell id="kv-123" value="512 KiB" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1190" y="778" width="140" height="48" as="geometry"/></mxCell><mxCell id="kv-124" value="2 GiB at 4K tokens" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1330" y="778" width="230" height="48" as="geometry"/></mxCell><mxCell id="kv-125" value='&lt;b&gt;Llama-3-8B&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555"&gt;32 layers · 8 KV heads (GQA) · head_dim 128&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="860" y="826" width="330" height="48" as="geometry"/></mxCell><mxCell id="kv-126" value="128 KiB" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1190" y="826" width="140" height="48" as="geometry"/></mxCell><mxCell id="kv-127" value="1 GiB at 8K tokens" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1330" y="826" width="230" height="48" as="geometry"/></mxCell><mxCell id="kv-128" value="e.g. Llama-3-8B: 2 × 32 × 8 × 128 × 2 B = 131,072 B = 128 KiB per token" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="860" y="886" width="720" height="30" as="geometry"/></mxCell><mxCell id="kv-129" value="• Grows linearly with sequence length × batch size — often what limits the batch size, not the weights&lt;br&gt;• Made smaller by GQA/MQA (fewer KV heads), FP8 KV cache, sliding-window attention&lt;br&gt;• Fragmentation is avoided with PagedAttention (page 4); shared prefixes are reused with prefix caching (page 5)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="920" width="720" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="mm" name="3 · MatMul on GPU"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1080" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="mm-2" value="Matrix multiply on a GPU: tiled GEMM, C = A × B" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1560" height="36" as="geometry"/></mxCell><mxCell id="mm-3" value="A is M×K, B is K×N, C is M×N; FLOPs = 2·M·N·K. C is cut into tiles, one thread block per tile. Tiles of A and B are staged through shared memory so every loaded element is reused many times." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1560" height="40" as="geometry"/></mxCell><mxCell id="mm-4" value="① Tiling the output matrix C" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=16;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fillColor=#f5f9fe;strokeColor=#6c8ebf;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="640" height="570" as="geometry"/></mxCell><mxCell id="mm-5" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="130" y="340" width="34" height="34" as="geometry"/></mxCell><mxCell id="mm-6" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="164" y="340" width="34" height="34" as="geometry"/></mxCell><mxCell id="mm-7" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="198" y="340" width="34" height="34" as="geometry"/></mxCell><mxCell id="mm-8" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="232" y="340" width="34" height="34" as="geometry"/></mxCell><mxCell id="mm-9" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="266" y="340" width="34" height="34" as="geometry"/></mxCell><mxCell id="mm-10" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="130" y="374" width="34" height="34" as="geometry"/></mxCell><mxCell id="mm-11" value="" style="rounded=0;whiteSpace=wrap;html=