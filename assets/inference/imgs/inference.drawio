or=#333333;" vertex="1" parent="1"><mxGeometry x="620" y="380" width="80" height="30" as="geometry"/></mxCell><mxCell id="pa-97" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#2a9d8f;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="395" as="sourcePoint"/><mxPoint x="858" y="231" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pa-98" value="The block table works like a page table: logical block i of a request can live in any physical block. A new block is taken from the free pool only when the last one is full (A's next 3 tokens still fit in block 3). The attention kernel reads K and V block by block through this table." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="430" width="720" height="80" as="geometry"/></mxCell><mxCell id="pa-99" value="③ Why: contiguous pre-allocation wastes memory" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=16;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fillColor=#fdf5f5;strokeColor=#b85450;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="760" height="330" as="geometry"/></mxCell><mxCell id="pa-100" value="&lt;b&gt;Before&lt;/b&gt; — reserve max_len contiguous slots for every request:" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="586" width="720" height="20" as="geometry"/></mxCell><mxCell id="pa-101" value="A: 9" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="612" width="60" height="40" as="geometry"/></mxCell><mxCell id="pa-102" value="reserved for A, unused" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="120" y="612" width="190" height="40" as="geometry"/></mxCell><mxCell id="pa-103" value="gap" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e6e6e6;strokeColor=#999999;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="310" y="612" width="50" height="40" as="geometry"/></mxCell><mxCell id="pa-104" value="B: 6" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d0f0ef;strokeColor=#2a9d8f;" vertex="1" parent="1"><mxGeometry x="360" y="612" width="50" height="40" as="geometry"/></mxCell><mxCell id="pa-105" value="reserved for B, unused" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="410" y="612" width="190" height="40" as="geometry"/></mxCell><mxCell id="pa-106" value="free" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="600" y="612" width="160" height="40" as="geometry"/></mxCell><mxCell id="pa-107" value="internal fragmentation (reserved but unused) + external fragmentation (gaps between allocations)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="656" width="720" height="20" as="geometry"/></mxCell><mxCell id="pa-108" value="&lt;b&gt;Paged&lt;/b&gt; — 4-token blocks, allocated on demand:" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="696" width="720" height="20" as="geometry"/></mxCell><mxCell id="pa-109" value="A" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="722" width="72" height="40" as="geometry"/></mxCell><mxCell id="pa-110" value="A" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="132" y="722" width="72" height="40" as="geometry"/></mxCell><mxCell id="pa-111" value="A" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="204" y="722" width="18" height="40" as="geometry"/></mxCell><mxCell id="pa-112" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="222" y="722" width="54" height="40" as="geometry"/></mxCell><mxCell id="pa-113" value="B" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d0f0ef;strokeColor=#2a9d8f;" vertex="1" parent="1"><mxGeometry x="276" y="722" width="72" height="40" as="geometry"/></mxCell><mxCell id="pa-114" value="B" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d0f0ef;strokeColor=#2a9d8f;" vertex="1" parent="1"><mxGeometry x="348" y="722" width="36" height="40" as="geometry"/></mxCell><mxCell id="pa-115" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="384" y="722" width="36" height="40" as="geometry"/></mxCell><mxCell id="pa-116" value="free → room for more requests" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="722" width="340" height="40" as="geometry"/></mxCell><mxCell id="pa-117" value="waste only in the unfilled part of each request's last block" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="766" width="720" height="20" as="geometry"/></mxCell><mxCell id="pa-118" value="The vLLM authors measured only 20–38&amp;nbsp;% of KV-cache memory holding real tokens in earlier systems; with paging the waste is under 4&amp;nbsp;%. More requests fit in memory → larger batches → higher throughput." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="720" height="70" as="geometry"/></mxCell><mxCell id="pa-119" value="④ Sharing: parallel sampling with copy-on-write" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=16;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fillColor=#f6fbf4;strokeColor=#82b366;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="840" y="550" width="760" height="330" as="geometry"/></mxCell><mxCell id="pa-120" value="Two samples continue the same prompt (request A). They share its physical blocks (ref count 2). The first one to write into a shared block gets a private copy." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="584" width="720" height="40" as="geometry"/></mxCell><mxCell id="pa-121" value="block 7" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1130" y="650" width="64" height="30" as="geometry"/></mxCell><mxCell id="pa-122" value="The" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1196" y="650" width="62" height="30" as="geometry"/></mxCell><mxCell id="pa-123" value="quick" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1258" y="650" width="62" height="30" as="geometry"/></mxCell><mxCell id="pa-124" value="brown" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1320" y="650" width="62" height="30" as="geometry"/></mxCell><mxCell id="pa-125" value="fox" style="rounded=0;whiteS