idth="38" height="20" as="geometry"/></mxCell><mxCell id="mi-146" value="#3·0" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="364" y="698" width="38" height="20" as="geometry"/></mxCell><mxCell id="mi-147" value="#14·0" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="402" y="698" width="38" height="20" as="geometry"/></mxCell><mxCell id="mi-148" value="#14·1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="440" y="698" width="38" height="20" as="geometry"/></mxCell><mxCell id="mi-149" value="#14·2" style="rounded=0;whiteSpace=wrap;html=1;fontSize=9;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="478" y="698" width="38" height="20" as="geometry"/></mxCell><mxCell id="mi-150" value="slot mapping (physical block · slot)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="60" y="720" width="480" height="16" as="geometry"/></mxCell><mxCell id="mi-151" value="cu_seqlens&amp;nbsp;=&amp;nbsp;[0,&amp;nbsp;1,&amp;nbsp;2,&amp;nbsp;3,&amp;nbsp;4,&amp;nbsp;9,&amp;nbsp;12]" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="60" y="742" width="480" height="20" as="geometry"/></mxCell><mxCell id="mi-152" value="• A's block #11 filled up in iteration n → A's new token goes to a fresh block #15&lt;br&gt;• B's last chunk writes #13 and #3, then B samples its first token; from n+2 on B is just another decode&lt;br&gt;• F's first chunk is only 3 tokens: block #14 stays ¾ full and F's next chunk completes it (chunks need not be block-aligned)&lt;br&gt;• Requests join and leave between iterations → continuous batching (page 3)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="776" width="485" height="220" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="cb" name="3 · Continuous + ragged batching"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1090" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cb-2" value="Continuous (iteration-level) batching with ragged (packed) batches" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1560" height="36" as="geometry"/></mxCell><mxCell id="cb-3" value="Static batching keeps a batch together until its longest request finishes. Continuous batching re-forms the batch every iteration: finished requests leave, waiting ones join (as prefill chunks), and each iteration runs as one packed token stream." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1560" height="40" as="geometry"/></mxCell><mxCell id="cb-4" value="① Static (request-level) batching" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=16;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fillColor=#fdf5f5;strokeColor=#b85450;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1560" height="320" as="geometry"/></mxCell><mxCell id="cb-5" value='&lt;b&gt;R1&lt;/b&gt; &lt;span style="font-size:10px;color:#555555"&gt;prompt 4, output 3&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="176" width="185" height="30" as="geometry"/></mxCell><mxCell id="cb-6" value='&lt;b&gt;R2&lt;/b&gt; &lt;span style="font-size:10px;color:#555555"&gt;prompt 6, output 7&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="212" width="185" height="30" as="geometry"/></mxCell><mxCell id="cb-7" value='&lt;b&gt;R3&lt;/b&gt; &lt;span style="font-size:10px;color:#555555"&gt;prompt 3, output 4&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="248" width="185" height="30" as="geometry"/></mxCell><mxCell id="cb-8" value='&lt;b&gt;R4&lt;/b&gt; &lt;span style="font-size:10px;color:#555555"&gt;prompt 10, output 6&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="284" width="185" height="30" as="geometry"/></mxCell><mxCell id="cb-9" value='&lt;b&gt;R5&lt;/b&gt; &lt;span style="font-size:10px;color:#555555"&gt;prompt 5, output 4, arrives at it 2&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="185" height="30" as="geometry"/></mxCell><mxCell id="cb-10" value='&lt;b&gt;R6&lt;/b&gt; &lt;span style="font-size:10px;color:#555555"&gt;prompt 4, output 3, arrives at it 3&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="356" width="185" height="30" as="geometry"/></mxCell><mxCell id="cb-11" value="it 1&lt;br&gt;40 slots (23 real)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=