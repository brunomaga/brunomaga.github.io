try"/></mxCell><mxCell id="kb-125" value="&lt;b&gt;Prefix caching&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="520" y="452" width="120" height="24" as="geometry"/></mxCell><mxCell id="kb-126" value="&lt;b&gt;h&lt;/b&gt; = block hash · ✓ hit = block reused" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="648" y="452" width="330" height="24" as="geometry"/></mxCell><mxCell id="kb-127" value="&lt;b&gt;Chunked prefill&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d0f0ef;strokeColor=#2a9d8f;" vertex="1" parent="1"><mxGeometry x="1010" y="452" width="130" height="24" as="geometry"/></mxCell><mxCell id="kb-128" value="bracket = blocks filled in one iteration" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1148" y="452" width="330" height="24" as="geometry"/></mxCell><mxCell id="kb-129" value="② One block, three roles" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=16;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fillColor=#fafafa;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="900" height="350" as="geometry"/></mxCell><mxCell id="kb-130" value="Technique" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e6e6e6;strokeColor=#999999;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="556" width="160" height="28" as="geometry"/></mxCell><mxCell id="kb-131" value="The block is the …" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e6e6e6;strokeColor=#999999;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="556" width="380" height="28" as="geometry"/></mxCell><mxCell id="kb-132" value="What it buys" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e6e6e6;strokeColor=#999999;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="556" width="320" height="28" as="geometry"/></mxCell><mxCell id="kb-133" value="&lt;b&gt;PagedAttention&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="584" width="160" height="88" as="geometry"/></mxCell><mxCell id="kb-134" value="&lt;b&gt;memory unit&lt;/b&gt;: a per-request block table maps logical blocks to physical blocks anywhere in the pool" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="220" y="584" width="380" height="88" as="geometry"/></mxCell><mxCell id="kb-135" value="no fragmentation; a new block only when the last one is full; blocks can be shared" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="600" y="584" width="320" height="88" as="geometry"/></mxCell><mxCell id="kb-136" value="&lt;b&gt;Prefix caching&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="672" width="160" height="88" as="geometry"/></mxCell><mxCell id="kb-137" value="&lt;b&gt;reuse unit&lt;/b&gt;: a full block is identified by hash(parent hash, its tokens); a hit points the new block table at the existing block (ref count + 1)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="220" y="672" width="380" height="88" as="geometry"/></mxCell><mxCell id="kb-138" value="the shared prefix is neither recomputed nor stored twice → lower TTFT, less memory" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="600" y="672" width="320" height="88" as="geometry"/></mxCell><mxCell id="kb-139" value="&lt;b&gt;Chunked prefill&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d0f0ef;strokeColor=#2a9d8f;" vertex="1" parent="1"><mxGeometry x="60" y="760" width="160" height="88" as="geometry"/></mxCell><mxCell id="kb-140" value="&lt;b&gt;unit of work&lt;/b&gt;: each iteration fills a run of consecutive blocks with new K,V (chunk = token budget − decode tokens)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="220" y="760" width="380" height="88" as="geometry"/></mxCell><mxCell id="kb-141" value="long prompts don't stall running decodes; every iteration stays short" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="600" y="760" width="320" height="88" as="geometry"/></mxCell><mxCell id="kb-142" value="③ Request B, step by step" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=16;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fillColor=#f3fbfb;strokeColor=#2a9d8f;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="980" y="520" width="620" height="350" as="geometry"/></mxCell><mxCell id="kb-143" value="&lt;b&gt;1.&lt;/b&gt; B arrives with 21 prompt tokens. Its full blocks are hashed; h&lt;sub&gt;0&lt;/sub&gt; and h&lt;sub&gt;1&lt;/sub&gt; are found → B's block table points at #7 and #2 (ref count 2). Prefill starts at token 8, on a block boundary.&lt;br&gt;&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Iteration n — chunk 1 = b0–b7: allocate #5 and #0 and write their K,V. Attention reads #7, #2 (shared prefix) plus the chunk itself (causal).&lt;br&gt;&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Iteration n+1 — chunk 2 = b8–b12: allocate #13 and #3 (#3 only ¼ full). It holds the last prompt token → B's first output token is sampled.&lt;br&gt;&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; Decode: new tokens fill the free slots of #3; a new block is taken only when #3 is full (A just did this: #11 filled up, so g2 went to #15).&lt;br&gt;&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; Every block that becomes full is hashed and stays reusable by later requests until it is evicted (LRU)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="556" width="585" height="310" as="geometry"/></mxCell><mxCell id="kb-144" value="• Real engines use bigger numbers: blocks of 16 tokens (vLLM) and token budgets of hundreds to thousands of tokens per iteration, so one chunk spans many blocks.&lt;br&gt;• A chunk does not have to end on a block boundary: a partly filled block is completed by the next chunk or by decode. In vLLM, prefix-cache hits are whole blocks, so the first chunk after a hit always starts on a block boundary." style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="1560" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="mi" name="2 · Prefill + decode in one iteration"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1040" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="mi-2" value="Serving prefill chunks and decodes in the same iteration" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1560" height="36" as="geometry"/></mxCell><mxCell id="mi-3" value="Every iteration the scheduler fills a token budget, packs the chosen tokens into one stream and runs one forward pass. Decode tokens and prefill chunks share every matrix multiply; only attention treats them differently, through the block tables." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1560" height="40" as="geometry"/></mxCell><mxCell id="mi-4" value="① Scheduler: fill the token budget (12)" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=16;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fillColor=#fafafa;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="520" height="420" as="geometry"/></mxCell><mxCell id="mi-5" value="&lt;b&gt;running&lt;/b&gt; — decoding, 1 token each" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="136" width="480" height="18" as="geometry"/></mxCell><mxCell id="mi-6" value="A" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="158" width="58" height="34" as="geometry"/></mxCell><mxCell id="mi-7" value="C" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="126" y="158" width="58" height="34" as="geometry"/></mxCell><mxCell id="mi-8" value="D" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="192" y="158" width="58" height="34" as="geometry"/></mxCell><mxCell id="mi-9" value="E" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="258" y="158" width="58" height="34" as="geometry"/></mxCell><mxCell id="mi-10" value="&lt;b&gt;waiting&lt;/b&gt; — prompt tokens still to prefill" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="206" width="480" height="18" as="geometry"/></mxCell><mxCell id="mi-11" value='B: 13 tokens left&lt;br&gt;&lt;span style="font-size:10px;color:#333333"&gt;(first 8 already in the prefix cache)&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d0f0ef;strokeColor=#2a9d8f;" vertex="1" parent="1"><mxGeometry x="60" y="228" width="250" height="44" as="geometry"/></mxCell><mxCell id="mi-12" value='F: 30 tokens&lt;br&gt;&lt;span style="font-size:10px;color:#333333"&gt;(new, no cache hit)&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="320" y="228" width="220" height="44" as="geometry"/></mxCell><mxCell id="mi-13" value="&lt;b&gt;batch for iteration n&lt;/b&gt; (budget = 12 tokens)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="288" width="480" height="18" as="geometry"/></mxCell><mxCell id="mi-14" value="A" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="310" width="38" height="32" as="geometry"/></mxCell><mxCell id="mi-15" value="C" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="98" y="310" width="38" height="32" as="geometry"/></mxCell><mxCell id="mi-16" value="D" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="136" y="310" width="38" height="32" as="geometry"/></mxCell><mxCell id="mi-17" value="E" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="174" y="310" width="38" height="32" as="geometry"/></mxCell><mxCell id="mi-18" value="b0" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d0f0ef;strokeColor=#2a9d8f;" vertex="1" parent="1"><mxGeometry x="212" y="310" width="38" height="32" as="geometry"/></mxCell><mxCell id="mi-19" value="b1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d0f0ef;strokeColor=#2a9d8f;" vertex="1" parent="1"><mxGeometry x="250" y="310" width="38" height="32" as="geometry"/></mxCell><mxCell id="mi-20" value="b2" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d0f0ef;strokeColor=#2a9d8f;" vertex="1" parent="1"><mxGeometry x="288" y="310" width="38" height="32" as="geometry"/></mxCell><mxCell id="mi-21" value="b3" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d0f0ef;strokeColor=#2a9d8f;" vertex="1" parent="1"><mxGeometry x="326" y="310" width="38" height="32" as="geometry"/></mxCell><mxCell id="mi-22" value="b4" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d0f0ef;strokeColor=#2a9d8f;" vertex="1" parent="1"><mxGeometry x="364" y="310" width="38" height="32" as="geometry"/></mxCell><mxCell id="mi-23" value="b5" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d0f0ef;strokeColor=#2a9d8f;" vertex="1" parent="1"><mxGeometry x="402" y="310" width="38" height="32" as="geometry"/></mxCell><mxCell id="mi-24" value="b6" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d0f0ef;strokeColor=#2a9d8f;" vertex="1" parent="1"><mxGeometry x="440" y="310" width="38" height="32" as="geometry"/></mxCell><mxCell id="mi-25" value="b7" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d0f0ef;strokeColor=#2a9d8f;" vertex="1" parent="1"><mxGeometry x="478" y="310" width="38" height="32" as="geometry"/></mxCell><mxCell id="mi-26" value='&lt;b&gt;1.&lt;/b&gt; Decodes first: A, C, D, E → 4 tokens, 8 left&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Prefill chunk: B gets min(8, 13) = 8 tokens = its blocks 2–3&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Budget used up → F waits for the next iteration&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555"&gt;vLLM: --max-num-batched-tokens sets the budget&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="356" width="480" height="150" as="geometry"/></mxCell><mxCell id="mi-27" value="② Packed input of iteration n — 12 tokens, no padding" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=16;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fillColor=#f6fbf4;strokeColor=#82b366;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="600" y="100" width="1000" height="220" as="geometry"/></mxCell><mxCell id="mi-28" value="A" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="640" y="176" width="64" height="36" as="geometry"/></mxCell><mxCell id="mi-29" value="#11·3" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="640" y="216" width="64" height="22" as="geometry"/></mxCell><mxCell id="mi-30" value="C" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="704" y="176" width="64" height="36" as="geometry"/></mxCell><mxCell id="mi-31" value="#8·2" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="704" y="216" width="64" height="22" as="geometry"/></mxCell><mxCell id="mi-32" value="D" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="768" y="176" width="64" height="36" as="geometry"/></mxCell><mxCell id="mi-33" value="#12·0" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="768" y="216" width="64" height="22" as="geometry"/></mxCell><mxCell id="mi-34" value="E" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="832" y="176" width="64" height="36" as="geometry"/></mxCell><mxCell id="mi-35" value="#10·1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="832" y="216" width="64" height="22" as="geometry"/></mxCell><mxCell id="mi-36" value="b0" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d0f0ef;strokeColor=#2a9d8f;" vertex="1" parent="1"><mxGeometry x="896" y="176" width="64" height="36" as="geometry"/></mxCell><mxCell id="mi-37" value="#5·0" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="896" y="216" width="64" height="22" as="geometry"/></mxCell><mxCell id="mi-38" value="b1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d0f0ef;strokeColor=#2a9d8f;" vertex="1" parent="1"><mxGeometry x="960" y="176" width="64" height="36" as="geometry"/></mxCell><mxCell id="mi-39" value="#5·1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="960" y="216" width="64" height="22" as="geometry"/></mxCell><mxCell id="mi-40" value="b2" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d0f0ef;strokeColor=#2a9d8f;" vertex="1" parent="1"><mxGeometry x="1024" y="176" width="64" height="36" as="geometry"/></mxCell><mxCell id="mi-41" value="#5·2" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1024" y="216" width="64" height="22" as="geometry"/></mxCell><mxCell id="mi-42" value="b3" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d0f0ef;strokeColor=#2a9d8f;" vertex="1" parent="1"><mxGeometry x="1088" y="176" width="64" height="36" as="geometry"/></mxCell><mxCell id="mi-43" value="#5·3" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1088" y="216" width="64" height="22" as="geometry"/></mxCell><mxCell id="mi-44" value="b4" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d0f0ef;strokeColor=#2a9d8f;" vertex="1" parent="1"><mxGeometry x="1152" y="176" width="64" height="36" as="geometry"/></mxCell><mxCell id="mi-45" value="#0·0" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1152" y="216" width="64" height="22" as="geometry"/></mxCell><mxCell id="mi-46" value="b5" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d0f0ef;strokeColor=#2a9d8f;" vertex="1" parent="1"><mxGeometry x="1216" y="176" width="64" height="36" as="geometry"/></mxCell><mxCell id="mi-47" value="#0·1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1216" y="216" width="64" height="22" as="geometry"/></mxCell><mxCell id="mi-48" value="b6" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d0f0ef;strokeColor=#2a9d8f;" vertex="1" parent="1"><mxGeometry x="1280" y="176" width="64" height="36" as="geometry"/></mxCell><mxCell id="mi-49" value="#0·2" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1280" y="216" width="64" height="22" as="geometry"/></mxCell><mxCell id="mi-50" value="b7" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d0f0ef;strokeColor=#2a9d8f;" vertex="1" parent="1"><mxGeometry x="1344" y="176" width="64" height="36" as="geometry"/></mxCell><mxCell id="mi-51" value="#0·3" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1344" y="216" width="64" height="22" as="geometry"/></mxCell><mxCell id="mi-52" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.2;endSize=5;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="150" as="sourcePoint"/><mxPoint x="640" y="174" as="targetPoint"/></mxGeometry></mxCell><mxCell id="mi-53" value="0" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="132" width="40" height="16" as="geometry"/></mxCell><mxCell id="mi-54" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.2;endSize=5;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="704" y="150" as="sourcePoint"/><mxPoint x="704" y="174" as="targetPoint"/></mxGeometry></mxCell><mxCell id="mi-55" value="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="684" y="132" width="40" height="16" as="geometry"/></mxCell><mxCell id="mi-56" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.2;endSize=5;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="768" y="150" as="sourcePoint"/><mxPoint x="768" y="174" as="targetPoint"/></mxGeometry></mxCell><mxCell id="mi-57" value="2" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="748" y="132" width="40" height="16" as="geometry"/></mxCell><mxCell id="mi-58" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.2;endSize=5;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="832" y="150" as="sourcePoint"/><mxPoint x="832" y="174" as="targetPoint"/></mxGeometry></mxCell><mxCell id="mi-59" value="3" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="812" y="132" width="40" height="16" as="geometry"/></mxCell><mxCell id="mi-60" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.2;endSize=5;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="896" y="150" as="sourcePoint"/><mxPoint x="896" y="174" as="targetPoint"/></mxGeometry></mxCell><mxCell id="mi-61" value="4" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="876" y="132" width="40" height="16" as="geometry"/></mxCell><mxCell id="mi-62" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.2;endSize=5;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1408" y="150" as="sourcePoint"/><mxPoint x="1408" y="174" as="targetPoint"/></mxGeometry></mxCell><mxCell id="mi-63" value="12" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1388" y="132" width="40" height="16" as="geometry"/></mxCell><mxCell id="mi-64" value="slot mapping: where each token's new K,V is written (physical block · slot)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="640" y="242" width="768" height="16" as="geometry"/></mxCell><mxCell id="mi-65" value="cu_seqlens&amp;nbsp;=&amp;nbsp;[0,&amp;nbsp;1,&amp;nbsp;2,&amp;nbsp;3,&amp;nbsp;4,&amp;nbsp;12]" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="640" y="262" width="768" height="20" as="geometry"/></mxCell><mxCell id="mi-66" value="③ One forward pass — steps 2–5 repeat in every layer" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=16;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fillColor=#faf6fc;strokeColor=#9673a6;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="600" y="340" width="1000" height="660" as="geometry"/></mxCell><mxCell id="mi-67" value="&lt;b&gt;1. Hidden states&lt;/b&gt; X: [12 × d] — the packed tokens" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=center;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="620" y="380" width="560" height="40" as="geometry"/></mxCell><mxCell id="mi-68" value="&lt;b&gt;2. QKV projection&lt;/b&gt;: one GEMM [12 × d] · [d × 3d] for decode and prefill tokens together" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="620" y="440" width="560" height="46" as="geometry"/></mxCell><mxCell id="mi-69" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="420" as="sourcePoint"/><mxPoint x="900" y="440" as="targetPoint"/></mxGeometry></mxCell><mxCell id="mi-70" value="&lt;b&gt;3. Write K,V&lt;/b&gt; of all 12 tokens into the paged cache, at their slots" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="620" y="506" width="560" height="46" as="geometry"/></mxCell><mxCell id="mi-71" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="486" as="sourcePoint"/><mxPoint x="900" y="506" as="targetPoint"/></mxGeometry></mxCell><mxCell id="mi-72" value="&lt;b&gt;4. Attention&lt;/b&gt;, per segment (cu_seqlens + block tables)&lt;br&gt;• A, C, D, E: 1 query each × all of their cached K,V&lt;br&gt;• B: 8 queries × [prefix #7, #2 (shared) + causal within the chunk: #5, #0]" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="620" y="572" width="560" height="110" as="geometry"/></mxCell><mxCell id="mi-73" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="552" as="sourcePoint"/><mxPoint x="900" y="572" as="targetPoint"/></mxGeometry></mxCell><mxCell id="mi-74" value="&lt;b&gt;5. Output projection + MLP&lt;/b&gt;: one GEMM each over all 12 tokens" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="620" y="702" width="560" height="46" as="geometry"/></mxCell><mxCell id="mi-75" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="682" as="sourcePoint"/><mxPoint x="900" y="702" as="targetPoint"/></mxGeometry></mxCell><mxCell id="mi-76" value="&lt;b&gt;6. After the last layer — LM head + sampling&lt;/b&gt; only where a sequence ends in this batch: A, C, D, E get their next token. B's chunk is not its last → nothing is sampled for B yet." style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="620" y="768" width="560" height="76" as="geometry"/></mxCell><mxCell id="mi-77" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="748" as="sourcePoint"/><mxPoint x="900" y="768" as="targetPoint"/></mxGeometry></mxCell><mxCell id="mi-78" value="&lt;b&gt;Paged KV pool&lt;/b&gt; during iteration n" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1250" y="400" width="335" height="18" as="geometry"/></mxCell><mxCell id="mi-79" value="&lt;b&gt;#0&lt;/b&gt;&lt;br&gt;B" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1250" y="426" width="62" height="38" as="geometry"/></mxCell><mxCell id="mi-80" value="&lt;b&gt;#1&lt;/b&gt;&lt;br&gt;C" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1317" y="426" width="62" height="38" as="geometry"/></mxCell><mxCell id="mi-81" value="&lt;b&gt;#2&lt;/b&gt;&lt;br&gt;A+B" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1384" y="426" width="62" height="38" as="geometry"/></mxCell><mxCell id="mi-82" value="&lt;b&gt;#3&lt;/b&gt;&lt;br&gt;free" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="1451" y="426" width="62" height="38" as="geometry"/></mxCell><mxCell id="mi-83" value="&lt;b&gt;#4&lt;/b&gt;&lt;br&gt;A" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1518" y="426" width="62" height="38" as="geometry"/></mxCell><mxCell id="mi-84" value="&lt;b&g