</mxCell><mxCell id="mi-99" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1252" y="616" width="16" height="16" as="geometry"/></mxCell><mxCell id="mi-100" value="read (cached K,V)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1274" y="614" width="300" height="20" as="geometry"/></mxCell><mxCell id="mi-101" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1252" y="640" width="16" height="16" as="geometry"/></mxCell><mxCell id="mi-102" value="read + new K,V written" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1274" y="638" width="300" height="20" as="geometry"/></mxCell><mxCell id="mi-103" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="1252" y="664" width="16" height="16" as="geometry"/></mxCell><mxCell id="mi-104" value="free" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1274" y="662" width="300" height="20" as="geometry"/></mxCell><mxCell id="mi-105" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1180" y="529" as="sourcePoint"/><mxPoint x="1248" y="529" as="targetPoint"/></mxGeometry></mxCell><mxCell id="mi-106" value="write" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1184" y="510" width="62" height="16" as="geometry"/></mxCell><mxCell id="mi-107" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1248" y="600" as="sourcePoint"/><mxPoint x="1180" y="600" as="targetPoint"/></mxGeometry></mxCell><mxCell id="mi-108" value="read" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1184" y="581" width="62" height="16" as="geometry"/></mxCell><mxCell id="mi-109" value="• Linear layers don't care which request a token belongs to: one GEMM over all tokens, and the memory-bound decode tokens ride along with the compute-bound prefill chunk&lt;br&gt;• Only attention needs per-request context: cu_seqlens says where each segment starts, the block tables say where its K,V live&lt;br&gt;• One pass per iteration instead of separate prefill and decode passes" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="864" width="960" height="130" as="geometry"/></mxCell><mxCell id="mi-110" value="④ Next iteration (n+1), same budget" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=16;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fillColor=#f3fbfb;strokeColor=#2a9d8f;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="520" height="460" as="geometry"/></mxCell><mxCell id="mi-111" value="Decodes A, C, D, E (4) + B's last chunk b8–b12 (5) + F's first chunk f0–f2 (3) = 12 tokens" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="574" width="480" height="36" as="geometry"/></mxCell><mxCell id="mi-112" value="A" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="6