<mxfile host="Electron" agent="python" version="24.7.17" type="device" pages="3"><diagram id="kb" name="1 · One KV block, three uses"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="970" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="kb-2" value="One KV block, three uses: PagedAttention, prefix caching and chunked prefill" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1560" height="36" as="geometry"/></mxCell><mxCell id="kb-3" value="The KV cache is cut into fixed-size blocks (here 4 tokens; vLLM default 16). The same blocks are the memory unit of PagedAttention, the reuse unit of prefix caching, and what chunked prefill fills a few at a time." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1560" height="40" as="geometry"/></mxCell><mxCell id="kb-4" value="① Two requests with the same 8-token system prompt — state after iteration n+1" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=16;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fillColor=#fffaf3;strokeColor=#d79b00;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1560" height="400" as="geometry"/></mxCell><mxCell id="kb-5" value='&lt;b&gt;Request A&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555"&gt;18-token prompt,&lt;br&gt;now decoding&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="115" height="50" as="geometry"/></mxCell><mxCell