999999;dashed=1;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="526" y="356" width="86" height="30" as="geometry"/></mxCell><mxCell id="cb-62" value="waiting" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="618" y="356" width="86" height="30" as="geometry"/></mxCell><mxCell id="cb-63" value="waiting" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="710" y="356" width="86" height="30" as="geometry"/></mxCell><mxCell id="cb-64" value="waiting" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="802" y="356" width="86" height="30" as="geometry"/></mxCell><mxCell id="cb-65" value="prefill + pad" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="894" y="356" width="86" height="30" as="geometry"/></mxCell><mxCell id="cb-66" value="decode" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="986" y="356" width="86" height="30" as="geometry"/></mxCell><mxCell id="cb-67" value="decode ✓" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1078" y="356" width="86" height="30" as="geometry"/></mxCell><mxCell id="cb-68" value="idle" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e6e6e6;strokeColor=#bbbbbb;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="1170" y="356" width="86" height="30" as="geometry"/></mxCell><mxCell id="cb-69" value="• The batch runs until its longest request (R2) is done&lt;br&gt;• Finished requests leave idle slots behind (R1, R3, R4)&lt;br&gt;• Prompts are padded to the longest one (10 tokens)&lt;br&gt;• R5 and R6 wait for the whole batch, then form the next one: done at it 11 and it 10" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1280" y="140" width="300" height="170" as="geometry"/></mxCell><mxCell id="cb-70" value="② Continuous (iteration-level) batching — token budget 16, chunked prefill" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=16;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fillColor=#f6fbf4;strokeColor=#82b366;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="1560" height="320" as="geometry"/></mxCell><mxCell id="cb-71" value='&lt;b&gt;R1&lt;/b&gt; &lt;span style="font-size:10px;color:#555555"&gt;prompt 4, output 3&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="516" width="185" height="30" as="geometry"/></mxCell><mxCell id="cb-72" value='&lt;b&gt;R2&lt;/b&gt; &lt;span style="font-size:10px;color:#555555"&gt;prompt 6, output 7&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="552" width="185" height="30" as="geometry"/></mxCell><mxCell id="cb-73" value='&lt;b&gt;R3&lt;/b&gt; &lt;span style="font-size:10px;color:#555555"&gt;prompt 3, output 4&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="588" width="185" height="30" as="geometry"/></mxCell><mxCell id="cb-74" value='&lt;b&gt;R4&lt;/b&gt; &lt;span style="font-size:10px;color:#555555"&gt;prompt 10, output 6&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="624" width="185" height="30" as="geometry"/></mxCell><mxCell id="cb-75" value='&lt;b&gt;R5&lt;/b&gt; &lt;span style="font-size:10px;color:#555555"&gt;prompt 5, output 4, arrives at it 2&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="660" width="185" height="30" as="geometry"/></mxCell><mxCell id="cb-76" value='&lt;b&gt;R6&lt;/b&gt; &lt;span style="font-size:10px;color:#555555"&gt;prompt 4, output 3, arrives at it 3&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="696" width="185" height="30" as="geometry"/></mxCell><mxCell id="cb-77" value="it 1&lt;br&gt;16 tokens" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=10;" vertex="1" parent="1"><mxGeometry x="247" y="480" width="92" height="32" as="geometry"/></mxCell><mxCell id="cb-78" value="it 2&lt;br&gt;15 tokens" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=10;" vertex="1" parent="1"><mxGeometry x="339" y="480" width="92" height="32" as="geometry"/></mxCell><mxCell id="cb-79" value="it 3&lt;br&gt;9 tokens" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=10;" vertex="1" parent="1"><mxGeometry x="431" y="480" width="92" height="32" as="geometry"/></mxCell><mxCell id="cb-80" value="it 4&lt;br&gt;5 tokens" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=10;" vertex="1" parent="1"><mxGeometry x="523" y="480" width="92" height="32" as="geometry"/></mxCell><mxCell id="cb-81" value="it 5&lt;br&gt;4 tokens"