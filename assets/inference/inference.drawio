        <mxCell id="mtp_sequential-73" value="h&lt;sup&gt;1&lt;/sup&gt;" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=14;labelBackgroundColor=#ffffff;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;edgeStyle=orthogonalEdgeStyle;sourcePortConstraint=east;targetPortConstraint=west;" edge="1" parent="mtp_sequential-figure" source="mtp_sequential-41" target="mtp_sequential-64">
          <mxGeometry x="0" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="spec_decoding-note" value="&lt;b&gt;Speculative decoding with a draft model&lt;/b&gt;&lt;br&gt;The draft model proposes K = 4 tokens; the target checks them in one forward pass, and keeps the drafts up to the first mismatch, plus its own token there" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;">
          <mxGeometry x="952.87" y="40" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="spec_sampling-note" value="&lt;b&gt;Speculative sampling&lt;/b&gt;&lt;br&gt;A draft x sampled from p is accepted with probability min(1, q(x) / p(x)); a rejected draft is replaced by a token sampled from max(0, q - p), normalized, so that the output follows q exactly" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;">
          <mxGeometry x="1002" y="601" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="prompt_lookup-note" value="&lt;b&gt;Prompt lookup decoding&lt;/b&gt;&lt;br&gt;The last n-gram of the sequence (orange) is searched earlier in the context, and the tokens that followed its last occurrence become the drafts (purple)" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;">
          <mxGeometry x="1152" y="1039.8" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="medusa-note" value="&lt;b&gt;Medusa&lt;/b&gt;&lt;br&gt;Extra heads on the last hidden state predict the tokens after the next one; their top candidates form a tree, verified in one forward pass with tree attention" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;">
          <mxGeometry x="1478.84" y="1384.8" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="eagle-note" value="&lt;b&gt;EAGLE&lt;/b&gt;&lt;br&gt;A transformer layer predicts the next features of the target from its features and the embeddings of the next tokens, and the target's output layer turns them into drafts" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;">
          <mxGeometry x="1566" y="1785.2" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="dflash-note" value="&lt;b&gt;DFlash&lt;/b&gt;&lt;br&gt;A block diffusion drafter fills a block of mask tokens in one forward pass, conditioned on the hidden states of 5 target layers, injected into the keys and values of every draft layer" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;">
          <mxGeometry x="1344.3" y="2247.4" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="layerskip-note" value="&lt;b&gt;LayerSkip&lt;/b&gt;&lt;br&gt;The first E layers and the shared output head draft; the remaining layers verify the drafts, reusing the KV cache and the hidden states of the first layers" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;">
          <mxGeometry x="1072.25" y="2807.4" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="mtp_parallel-note" value="&lt;b&gt;Multi-token prediction with parallel heads&lt;/b&gt;&lt;br&gt;Head i, a transformer layer followed by the shared unembedding, predicts the token i positions ahead from the output of the shared trunk" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;">
          <mxGeometry x="940" y="3411.4" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="mtp_sequential-note" value="&lt;b&gt;Multi-token prediction with sequential modules (DeepSeek-V3)&lt;/b&gt;&lt;br&gt;Module k combines the hidden state of depth k-1 with the embedding of the token k positions ahead, and predicts the token k+1 positions ahead, keeping the causal chain" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;">
          <mxGeometry x="1100" y="4037.4" width="480" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
