ry x="600" y="170" width="250" height="30" as="geometry" /></mxCell><mxCell id="mtp_sequential-x3681" parent="mtp_sequential-figure" value="concatenation, projection &lt;span style=&quot;font-family: NewComputerModernSansMath;&quot;&gt;M&lt;/span&gt;&lt;sub&gt;&lt;span style=&quot;font-family: NewComputerModernSansMath;&quot;&gt;2&lt;/span&gt;&lt;/sub&gt;" style="rounded=1;whiteSpace=nowrap;html=1;fontFamily=Source Sans 3;fontSize=14;fontColor=#000000;strokeColor=#000000;strokeWidth=1.0;fillColor=#ffe6cc;absoluteArcSize=1;arcSize=10;fontStyle=0;verticalAlign=middle;align=center;" vertex="1"><mxGeometry x="600" y="230" width="250" height="30" as="geometry" /></mxCell><mxCell id="mtp_sequential-x3682" parent="mtp_sequential-figure" value="" style="endArrow=classic;endFill=1;endSize=5;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.4;fontFamily=Source Sans 3;fontSize=14;fontColor=#000000;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="725" y="230" as="sourcePoint" /><mxPoint x="725" y="200" as="targetPoint" /></mxGeometry></mxCell><mxCell id="mtp_sequential-x3683" parent="mtp_sequential-figure" value="RMSNorm" style="rounded=1;whiteSpace=nowrap;html=1;fontFamily=Source Sans 3;fontSize=14;fontColor=#000000;strokeColor=#000000;strokeWidth=1.0;fillColor=#ffe6cc;absoluteArcSize=1;arcSize=10;fontStyle=0;verticalAlign=middle;align=center;" vertex="1"><mxGeometry x="600" y="290" width="115" height="30" as="geometry" /></mxCell><mxCell id="mtp_sequential-x3684" parent="mtp_sequential-figure" value="" style="endArrow=classic;endFill=1;endSize=5;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.4;fontFamily=Source Sans 3;fontSize=14;fontColor=#000000;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="657.5" y="290" as="sourcePoint" /><mxPoint x="657.5" y="260" as="targetPoint" /></mxGeometry></mxCell><mxCell id="mtp_sequential-x3685" parent="mtp_sequential-figure" value="RMSNorm" style="rounded=1;whiteSpace=nowrap;html=1;fontFamily=Source Sans 3;font