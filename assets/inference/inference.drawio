          </mxGeometry>
        </mxCell>
        <mxCell id="disaggregation-19" value="layer-wise streaming of the KV cache" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#000000;" vertex="1" parent="disaggregation-figure">
          <mxGeometry x="0" y="247" width="278.4" height="24" as="geometry" />
        </mxCell>
        <mxCell id="disaggregation-20" value="prefill compute" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=14;fontStyle=0;fontColor=#000000;" vertex="1" parent="disaggregation-figure">
          <mxGeometry x="49.14" y="301.6" width="100.86" height="22.8" as="geometry" />
        </mxCell>
        <mxCell id="disaggregation-21" value="KV cache transfer" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=14;fontStyle=0;fontColor=#000000;" vertex="1" parent="disaggregation-figure">
          <mxGeometry x="28.5" y="345.6" width="121.5" height="22.8" as="geometry" />
        </mxCell>
        <mxCell id="disaggregation-22" value="decode" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=14;fontStyle=0;fontColor=#000000;" vertex="1" parent="disaggregation-figure">
          <mxGeometry x="95.15" y="389.6" width="54.85" height="22.8" as="geometry" />
        </mxCell>
        <mxCell id="disaggregation-23" value="layer 1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=13;fontStyle=0;strokeColor=#000000;strokeWidth=0.8;" vertex="1" parent="disaggregation-figure">
          <mxGeometry x="170" y="298" width="106" height="30" as="geometry" />
        </mxCell>
        <mxCell id="disaggregation-24" value="KV of layer 1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;fontSize=13;fontStyle=0;strokeColor=#000000;strokeWidth=0.8;" vertex="1" parent="disaggregation-figure">
          <mxGeometry x="280" y="342" width="106" height="30" as="geometry" />
        </mxCell>
        <mxCell id="disaggregation-25" value="layer 2" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=13;fontStyle=0;strokeColor=#000000;strokeWidth=0.8;" vertex="1" parent="disaggregation-figure">
          <mxGeometry x="280" y="298" width="106" height="30" as="geometry" />
        </mxCell>
        <mxCell id="disaggregation-26" value="KV of layer 2" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;fontSize=13;fontStyle=0;strokeColor=#000000;strokeWidth=0.8;" vertex="1" parent="disaggregation-figure">
          <mxGeometry x="390" y="342" width="106" height="30" as="geometry" />
        </mxCell>
        <mxCell id="disaggregation-27" value="layer 3" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=13;fontStyle=0;strokeColor=#000000;strokeWidth=0.8;" vertex="1" parent="disaggregation-figure">
          <mxGeometry x="390" y="298" width="106" height="30" as="geometry" />
        </mxCell>
        <mxCell id="disaggregation-28" value="KV of layer 3" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;fontSize=13;fontStyle=0;strokeColor=#000000;strokeWidth=0.8;" vertex="1" parent="disaggregation-figure">
          <mxGeometry x="500" y="342" width="106" height="30" as="geometry" />
        </mxCell>
        <mxCell id="disaggregation-29" value="layer 4" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=13;fontStyle=0;strokeColor=#000000;strokeWidth=0.8;" vertex="1" parent="disaggregation-figure">
          <mxGeometry x="500" y="298" width="106" height="30" as="geometry" />
        </mxCell>
        <mxCell id="disaggregation-30" value="KV of layer 4" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;fontSize=13;fontStyle=0;strokeColor=#000000;strokeWidth=0.8;" vertex="1" parent="disaggregation-figure">
          <mxGeometry x="610" y="342" width="106" height="30" as="geometry" />
        </mxCell>
        <mxCell id="disaggregation-31" value="decode steps" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;fontSize=13;fontStyle=0;strokeColor=#000000;strokeWidth=0.8;" vertex="1" parent="disaggregation-figure">
          <mxGeometry x="720" y="386" width="216" height="30" as="geometry" />
        </mxCell>
        <mxCell id="disaggregation-32" value="The transfer of each layer overlaps with the compute of the next layers: only the transfer of the last layer delays the decode" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=0;fontColor=#000000;" vertex="1" parent="disaggregation-figure">
          <mxGeometry x="0" y="431.6" width="784.3" height="22.8" as="geometry" />
        </mxCell>
        <mxCell id="prefill_decode-note" value="&lt;b&gt;Prefill and decode&lt;/b&gt;&lt;br&gt;Prefill processes all the prompt tokens in one forward pass; each decode step processes the newest token, and reads the keys and values of the earlier tokens from the KV cache" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;">
          <mxGeometry x="1200" y="40" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="matmul-note" value="&lt;b&gt;Matrix multiplication&lt;/b&gt;&lt;br&gt;[A, B] @ [B, C] -&gt; [A, C]: each of the AC outputs is the dot product of a row and a column, with B multiply-adds" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;">
          <mxGeometry x="621.64" y="1540.5" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="kv_cache-note" value="&lt;b&gt;KV cache&lt;/b&gt;&lt;br&gt;Decode step of the token at position S, in one attention head: without a cache, it computes the queries, keys and values of all the S tokens again; with a cache, only those of the new token" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;">
          <mxGeometry x="1149" y="2001.51" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="static_cache-note" value="&lt;b&gt;Dynamic and static KV cache&lt;/b&gt;&lt;br&gt;torch.cat copies the whole cache into a new tensor at every step; a static cache is allocated once, and written in place" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;">
          <mxGeometry x="744.85" y="2703.51" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="paged_attention-note" value="&lt;b&gt;PagedAttention&lt;/b&gt;&lt;br&gt;The KV cache is split into blocks of 4 tokens, allocated on demand from a shared pool; the block table of each sequence maps its logical blocks to physical blocks, anywhere in the pool" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;">
          <mxGeometry x="1049.65" y="3345.51" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="prefix_caching-note" value="&lt;b&gt;Prefix caching&lt;/b&gt;&lt;br&gt;Each full block of 4 tokens is identified by a hash of its tokens and of the hash of the previous block; a request reuses the cached blocks up to the first miss, and only prefills the rest" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;">
          <mxGeometry x="1145.16" y="3872.31" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="semantic_caching-note" value="&lt;b&gt;Semantic caching&lt;/b&gt;&lt;br&gt;The cache returns the stored answer of the most similar past query, if their similarity is above a threshold; otherwise, it calls the model and stores the new pair" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;">
          <mxGeometry x="1400" y="4413.31" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="chunked_prefill-note" value="&lt;b&gt;Chunked prefill&lt;/b&gt;&lt;br&gt;An 8,000-token prompt arrives while 50 sequences decode: with a budget of 512 tokens per step, each step takes the 50 decode tokens, and a chunk of 462 prompt tokens" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;">
          <mxGeometry x="1060.98" y="5606.71" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ragged_batching-note" value="&lt;b&gt;Padded and ragged batching&lt;/b&gt;&lt;br&gt;A padded batch is a rectangle with padding tokens; a ragged batch concatenates the sequences into one flat list of tokens, separated by a block-diagonal causal mask" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;">
          <mxGeometry x="966" y="6119.11" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="disaggregation-note" value="&lt;b&gt;Prefill-decode disaggregation&lt;/b&gt;&lt;br&gt;Prefill and decode run on separate pools of GPUs; the KV cache of each prompt goes from a prefill worker to a decode worker, layer by layer" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;">
          <mxGeometry x="1041.74" y="6712.51" width="480" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
