<mxCell id="quantization_mapping-88" value="s = max|x| / 7, z = 0: the levels below -1 are never used" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#666666;" vertex="1" parent="quantization_mapping-figure"><mxGeometry x="24.0" y="170" width="432.0" height="22" as="geometry" /></mxCell>
<mxCell id="quantization_mapping-89" value="s = (max x - min x) / 15, z = round(-min x / s) = 4: all 16 levels are used" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#666666;" vertex="1" parent="quantization_mapping-figure"><mxGeometry x="24.0" y="360" width="432.0" height="22" as="geometry" /></mxCell>
