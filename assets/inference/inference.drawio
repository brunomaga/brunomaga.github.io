        </mxCell>
        <mxCell id="disaggregation-27" value="layer 3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=14;fontStyle=0;strokeColor=#000000;strokeWidth=1.0;fontFamily=Source Sans 3;fontColor=#000000;" vertex="1" parent="disaggregation-figure">
          <mxGeometry x="342.54" y="260.59" width="92.69" height="26.23" as="geometry" />
        </mxCell>
        <mxCell id="disaggregation-28" value="KV of layer 3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;fontSize=14;fontStyle=0;strokeColor=#000000;strokeWidth=1.0;fontFamily=Source Sans 3;fontColor=#000000;" vertex="1" parent="disaggregation-figure">
          <mxGeometry x="438.73" y="299.07" width="92.69" height="26.23" as="geometry" />
        </mxCell>
        <mxCell id="disaggregation-29" value="layer 4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=14;fontStyle=0;strokeColor=#000000;strokeWidth=1.0;fontFamily=Source Sans 3;fontColor=#000000;" vertex="1" parent="disaggregation-figure">
          <mxGeometry x="438.73" y="260.59" width="92.69" height="26.23" as="geometry" />
        </mxCell>
        <mxCell id="disaggregation-30" value="KV of layer 4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;fontSize=14;fontStyle=0;strokeColor=#000000;strokeWidth=1.0;fontFamily=Source Sans 3;fontColor=#000000;" vertex="1" parent="disaggregation-figure">
          <mxGeometry x="534.92" y="299.07" width="92.69" height="26.23" as="geometry" />
        </mxCell>
        <mxCell id="disaggregation-31" value="decode steps" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;fontSize=14;fontStyle=0;strokeColor=#000000;strokeWidth=1.0;fontFamily=Source Sans 3;fontColor=#000000;" vertex="1" parent="disaggregation-figure">
          <mxGeometry x="631.11" y="337.54" width="188.88" height="26.23" as="geometry" />
        </mxCell>
        <mxCell id="prefill_decode-note" value="&lt;b&gt;Prefill and decode&lt;/b&gt;&lt;br&gt;Prefill processes all the prompt tokens in one forward pass; each decode step processes the newest token, and reads the keys and values of the earlier tokens from the KV cache" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Source Sans 3;">
          <mxGeometry x="1200" y="40" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="matmul-note" value="&lt;b&gt;Matrix multiplication&lt;/b&gt;&lt;br&gt;[A, B] @ [B, C] -&gt; [A, C]: each of the AC outputs is the dot product of a row and a column, with B multiply-adds" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Source Sans 3;">
          <mxGeometry x="621.64" y="1638.26" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="kv_cache-note" value="&lt;b&gt;KV cache&lt;/b&gt;&lt;br&gt;Decode step of the token at position S, in one attention head: without a cache, it computes the queries, keys and values of all the S tokens again; with a cache, only those of the new token" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Source Sans 3;">
          <mxGeometry x="1149" y="2099.27" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="static_cache-note" value="&lt;b&gt;Dynamic and static KV cache&lt;/b&gt;&lt;br&gt;torch.cat copies the whole cache into a new tensor at every step; a static cache is allocated once, and written in place" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Source Sans 3;">
          <mxGeometry x="744.85" y="3028.1" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="paged_attention-note" value="&lt;b&gt;PagedAttention&lt;/b&gt;&lt;br&gt;The KV cache is split into blocks of 4 tokens, allocated on demand from a shared pool; the block table of each sequence maps its logical blocks to physical blocks, anywhere in the pool" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Source Sans 3;">
          <mxGeometry x="1049.65" y="3670.1" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="prefix_caching-note" value="&lt;b&gt;Prefix caching&lt;/b&gt;&lt;br&gt;Each full block of 4 tokens is identified by a hash of its tokens and of the hash of the previous block; a request reuses the cached blocks up to the first miss, and only prefills the rest" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Source Sans 3;">
          <mxGeometry x="1145.16" y="4196.9" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="semantic_caching-note" value="&lt;b&gt;Semantic caching&lt;/b&gt;&lt;br&gt;The cache returns the stored answer of the most similar past query, if their similarity is above a threshold; otherwise, it calls the model and stores the new pair" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Source Sans 3;">
          <mxGeometry x="1400" y="4737.9" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="chunked_prefill-note" value="&lt;b&gt;Chunked prefill&lt;/b&gt;&lt;br&gt;An 8,000-token prompt arrives while 50 sequences decode: with a budget of 512 tokens per step, each step takes the 50 decode tokens, and a chunk of 462 prompt tokens" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Source Sans 3;">
          <mxGeometry x="1060.98" y="5931.3" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ragged_batching-note" value="&lt;b&gt;Padded and ragged batching&lt;/b&gt;&lt;br&gt;A padded batch is a rectangle with padding tokens; a ragged batch concatenates the sequences into one flat list of tokens, separated by a block-diagonal causal mask" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Source Sans 3;">
          <mxGeometry x="966" y="6443.7" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="disaggregation-note" value="&lt;b&gt;Prefill-decode disaggregation&lt;/b&gt;&lt;br&gt;Prefill and decode run on separate pools of GPUs; the KV cache of each prompt goes from a prefill worker to a decode worker, layer by layer" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Source Sans 3;">
          <mxGeometry x="1041.74" y="7037.1" width="480" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
