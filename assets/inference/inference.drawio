3;fontSize=14;fontColor=#000000;strokeColor=#000000;strokeWidth=1.0;fillColor=#f5f5f5;absoluteArcSize=1;arcSize=10;fontStyle=0;verticalAlign=middle;align=center;" vertex="1"><mxGeometry x="600" y="360" width="250" height="30" as="geometry" /></mxCell><mxCell id="mtp_sequential-x3691" parent="mtp_sequential-figure" value="" style="endArrow=classic;endFill=1;endSize=5;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.4;fontFamily=Source Sans 3;fontSize=14;fontColor=#000000;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="725" y="410" as="sourcePoint" /><mxPoint x="725" y="390" as="targetPoint" /></mxGeometry></mxCell><mxCell id="mtp_sequential-x3692" parent="mtp_sequential-figure" value="t&lt;sub&gt;3&lt;/sub&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=NewComputerModernSansMath;fontSize=14;fontColor=#000000;strokeColor=#000000;strokeWidth=1.0;fillColor=#f5f5f5;fontStyle=0;verticalAlign=middle;align=center;" vertex="1"><mxGeometry x="624" y="414" width="46" height="30" as="geometry" /></mxCell><mxCell id="mtp_sequential-x3693" parent="mtp_sequential-figure" value="t&lt;sub&gt;4&lt;/sub&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=NewComputerModernSansMath;fontSize=14;fontColor=#000000;strokeColor=#000000;strokeWidth=1.0;fillColor=#f5f5f5;fontStyle=0;verticalAlign=middle;align=center;" vertex="1"><mxGeometry x="676" y="414" width="46" height="30" as="geometry" /></mxCell><mxCell id="mtp_sequential-x3694" parent="mtp_sequential-figure" value="t&lt;sub&gt;5&lt;/sub&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=NewComputerModernSansMath;fontSize=14;fontColor=#000000;strokeColor=#000000;strokeWidth=1.0;fillColor=#f5f5f5;fontStyle=0;verticalAlign=middle;align=center;" vertex="1"><mxGeometry x="728" y="414" width="46" height="30" as="geometry" /></mxCell><mxCell id="mtp_sequential-x3695" parent="mtp_sequential-figure" value="t&lt;sub&gt;6&lt;/sub&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=NewComputerModernSansMath;fontSize=14;fontColor=#000000;strokeColor=#000000;strokeWidth=1.0;fillColor=#f5f5f5;fontStyle=0;verticalAlign=middle;align=center;" vertex="1"><mxGeometry x="780" y="414" width="46" height="30" as="geometry" /></mxCell><mxCell id="mtp_sequential-x3696" parent="mtp_sequential-figure" value="" vertex="1" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.8;rounded=1;absoluteArcSize=1;arcSize=20;dashed=1;fontFamily=Source Sans 3;"><mxGeometry x="620" y="410" width="210" height="38" as="geometry" /></mxCell><mxCell id="spec_decoding-note" value="&lt;b&gt;Speculative decoding with a draft model&lt;/b&gt;&lt;br&gt;The draft model proposes K = 4 tokens; the target checks them in one forward pass, and keeps the drafts up to the first mismatch, plus its own token there" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Source Sans 3;">
          <mxGeometry x="952.87" y="1204.95" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="spec_sampling-note" value="&lt;b&gt;Speculative sampling&lt;/b&gt;&lt;br&gt;A draft x sampled from p is accepted with probability min(1, q(x) / p(x)); a rejected draft is replaced by a token sampled from max(0, q - p), normalized, so that the output follows q exactly" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Source Sans 3;">
          <mxGeometry x="1002" y="1765.95" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="prompt_lookup-note" value="&lt;b&gt;Prompt lookup decoding&lt;/b&gt;&lt;br&gt;The last n-gram of the sequence (orange) is searched earlier in the context, and the tokens that followed its last occurrence become the drafts (purple)" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Source Sans 3;">
          <mxGeometry x="1152" y="2204.75" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="medusa-note" value="&lt;b&gt;Medusa&lt;/b&gt;&lt;br&gt;Extra heads on the last hidden state predict the tokens after the next one; their top candidates form a tree, verified in one forward pass with tree attention" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Source Sans 3;">
          <mxGeometry x="1478.84" y="2549.75" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="eagle-note" value="&lt;b&gt;EAGLE&lt;/b&gt;&lt;br&gt;A transformer layer predicts the next features of the target from its features and the embeddings of the next tokens, and the target's output layer turns them into drafts" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Source Sans 3;">
          <mxGeometry x="1566" y="2950.15" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="dflash-note" value="&lt;b&gt;DFlash&lt;/b&gt;&lt;br&gt;A block diffusion drafter fills a block of mask tokens in one forward pass, conditioned on the hidden states of 5 target layers, injected into the keys and values of every draft layer" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Source Sans 3;">
          <mxGeometry x="1344.3" y="3412.35" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="layerskip-note" value="&lt;b&gt;LayerSkip&lt;/b&gt;&lt;br&gt;The first E layers and the shared output head draft; the remaining layers verify the drafts, reusing the KV cache and the hidden states of the first layers" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Source Sans 3;">
          <mxGeometry x="1072.25" y="3972.35" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="mtp_parallel-note" value="&lt;b&gt;Multi-token prediction with parallel heads&lt;/b&gt;&lt;br&gt;Head i, a transformer layer followed by the shared unembedding, predicts the token i positions ahead from the output of the shared trunk" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Source Sans 3;">
          <mxGeometry x="940" y="4576.35" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="mtp_sequential-note" value="&lt;b&gt;Multi-token prediction with sequential modules (DeepSeek-V3)&lt;/b&gt;&lt;br&gt;Module k combines the hidden state of depth k-1 with the embedding of the token k positions ahead, and predicts the token k+1 positions ahead, keeping the causal chain" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Source Sans 3;">
          <mxGeometry x="1100" y="5202.35" width="480" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
