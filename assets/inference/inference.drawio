        <mxCell id="hca-12" parent="hca-3" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#666666;" value="0" vertex="1">
          <mxGeometry height="20.4" width="14.24" x="7.88" as="geometry" y="-2.2" />
        </mxCell>
        <mxCell id="hca-13" parent="hca-3" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#666666;" value="1" vertex="1">
          <mxGeometry height="20.4" width="14.24" x="37.88" as="geometry" y="-2.2" />
        </mxCell>
        <mxCell id="hca-14" parent="hca-3" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#666666;" value="2" vertex="1">
          <mxGeometry height="20.4" width="14.24" x="67.88" as="geometry" y="-2.2" />
        </mxCell>
        <mxCell id="hca-15" parent="hca-3" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#666666;" value="3" vertex="1">
          <mxGeometry height="20.4" width="14.24" x="97.88" as="geometry" y="-2.2" />
        </mxCell>
        <mxCell id="hca-16" parent="hca-3" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#666666;" value="4" vertex="1">
          <mxGeometry height="20.4" width="14.24" x="127.88" as="geometry" y="-2.2" />
        </mxCell>
        <mxCell id="hca-17" parent="hca-3" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#666666;" value="5" vertex="1">
          <mxGeometry height="20.4" width="14.24" x="157.88" as="geometry" y="-2.2" />
        </mxCell>
        <mxCell id="hca-18" parent="hca-3" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#666666;" value="6" vertex="1">
          <mxGeometry height="20.4" width="14.24" x="187.88" as="geometry" y="-2.2" />
        </mxCell>
        <mxCell id="hca-19" parent="hca-3" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#666666;" value="7" vertex="1">
          <mxGeometry height="20.4" width="14.24" x="217.88" as="geometry" y="-2.2" />
        </mxCell>
        <mxCell id="sdpa-note" value="&lt;b&gt;Scaled dot-product attention, for one head&lt;/b&gt;&lt;br&gt;The scores of the queries and the keys are scaled, masked (here with the causal mask: query i sees the keys up to i) and normalized with a softmax, and weight the sum of the values" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;">
          <mxGeometry x="948.35" y="40" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="mha-note" value="&lt;b&gt;Multi-Head Attention (MHA)&lt;/b&gt;&lt;br&gt;Every head has its own query, key and value (one color per head): the KV cache holds H heads of keys and values per token" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;">
          <mxGeometry x="1460" y="530.03" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="mqa-note" value="&lt;b&gt;Multi-Query Attention (MQA)&lt;/b&gt;&lt;br&gt;All the query heads share a single key head and value head: the KV cache is H times smaller than with MHA" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;">
          <mxGeometry x="1460" y="1142.86" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="gqa-note" value="&lt;b&gt;Grouped-Query Attention (GQA)&lt;/b&gt;&lt;br&gt;The query heads of a group (same color) share the key head and the value head of their group: the KV cache is H/G times smaller than with MHA" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;">
          <mxGeometry x="1460" y="1683.69" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="mla-note" value="&lt;b&gt;Multi-head Latent Attention (MLA)&lt;/b&gt;&lt;br&gt;The keys and values of all heads come from a latent vector of size C per token (purple), the only thing in the KV cache. With absorption, attention runs directly over the latent vectors" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;">
          <mxGeometry x="1250" y="2248.52" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="dsa-note" value="&lt;b&gt;DeepSeek Sparse Attention (DSA)&lt;/b&gt;&lt;br&gt;A lightning indexer (orange) scores the past tokens of each query, and every head attends only to the top_k = 3 tokens with the highest scores (the same tokens for all heads)" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;">
          <mxGeometry x="1355.2" y="3703.01" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="csa-note" value="&lt;b&gt;DeepSeek-V4: Compressed Sparse Attention (CSA)&lt;/b&gt;&lt;br&gt;Every m tokens are compressed into one entry; a lightning indexer selects the top_k entries of each query, which also attends to the uncompressed tokens of a sliding window" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;">
          <mxGeometry x="1090" y="4572.28" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="hca-note" value="&lt;b&gt;DeepSeek-V4: Heavily Compressed Attention (HCA)&lt;/b&gt;&lt;br&gt;Every m tokens are compressed into one entry, without overlap; each query attends to all the visible entries and to the uncompressed tokens of a sliding window" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;">
          <mxGeometry x="1000" y="5173.08" width="480" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
