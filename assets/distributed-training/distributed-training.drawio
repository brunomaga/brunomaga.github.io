        <mxCell id="moe_switch_transformers_2-2" value="&lt;b style=&quot;font-size:16px&quot;&gt;Experts:&lt;/b&gt; Split across devices,&lt;br&gt;each having their own unique&lt;br&gt;parameters. Perform standard feed-&lt;br&gt;forward computation." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#333333;spacing=0;spacingLeft=3;" vertex="1" parent="moe_switch_transformers_2-figure">
