        <mxCell id="moe_switch_transformers_2-7" value="&lt;b style=&quot;font-size:16px&quot;&gt;Capacity Factor:&lt;/b&gt; Used when&lt;br&gt;calculating expert capacity. Expert&lt;br&gt;capacity allows more buffer to help&lt;br&gt;mitigate token overflow during&lt;br&gt;routing." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#666666;spacing=0;spacingLeft=3;" vertex="1" parent="moe_switch_transformers_2-figure">
