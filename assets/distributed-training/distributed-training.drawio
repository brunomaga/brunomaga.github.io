        <mxCell id="moe_switch_transformers_2-1" value="Terminology" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=18;fontStyle=2;" vertex="1" parent="moe_switch_transformers_2-figure">
          <mxGeometry x="52.28" y="0" width="113.34" height="25.6" as="geometry" />
        </mxCell>
        <mxCell id="moe_switch_transformers_2-2" value="&lt;b style=&quot;font-size:16px&quot;&gt;Experts:&lt;/b&gt; Split across devices,&lt;br&gt;each having their own unique&lt;br&gt;parameters. Perform standard feed-&lt;br&gt;forward computation." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#666666;spacing=0;spacingLeft=3;" vertex="1" parent="moe_switch_transformers_2-figure">
          <mxGeometry x="12.8" y="43" width="240" height="68.4" as="geometry" />
        </mxCell>
        <mxCell id="moe_switch_transformers_2-3" value="•" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontColor=#666666;" vertex="1" parent="moe_switch_transformers_2-figure">
          <mxGeometry x="0" y="43.11" width="10.9" height="20.8" as="geometry" />
        </mxCell>
        <mxCell id="moe_switch_transformers_2-4" value="&lt;b style=&quot;font-size:16px&quot;&gt;Expert Capacity:&lt;/b&gt; Batch size of&lt;br&gt;each expert. Calculated as&lt;br&gt;(tokens_per_batch / num_experts) *&lt;br&gt;capacity_factor" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#666666;spacing=0;spacingLeft=3;" vertex="1" parent="moe_switch_transformers_2-figure">
