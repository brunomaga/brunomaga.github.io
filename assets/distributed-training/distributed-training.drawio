        <mxCell id="moe_switch_transformers_2-4" value="&lt;b style=&quot;font-size:16px&quot;&gt;Expert Capacity:&lt;/b&gt; Batch size of&lt;br&gt;each expert. Calculated as&lt;br&gt;(tokens_per_batch / num_experts) *&lt;br&gt;capacity_factor" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#333333;spacing=0;spacingLeft=3;" vertex="1" parent="moe_switch_transformers_2-figure">
