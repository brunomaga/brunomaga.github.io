        <mxCell id="moe_switch_transformers_2-x844" parent="moe_switch_transformers_2-figure" value="Terminology" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Source Sans 3;fontSize=14;fontColor=#000000;fontStyle=1;" vertex="1"><mxGeometry x="0" y="0" width="78.8" height="16.8" as="geometry" /></mxCell><mxCell id="moe_switch_transformers_2-x845" parent="moe_switch_transformers_2-figure" value="•" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Source Sans 3;fontSize=14;fontColor=#000000;fontStyle=0;" vertex="1"><mxGeometry x="0" y="30" width="5.9" height="16.8" as="geometry" /></mxCell><mxCell id="moe_switch_transformers_2-x846" parent="moe_switch_transformers_2-figure" value="&lt;b&gt;Experts:&lt;/b&gt; Split across devices, each&lt;br&gt;having their own unique parameters.&lt;br&gt;Perform standard feed-forward&lt;br&gt;computation." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Source Sans 3;fontSize=14;fontColor=#000000;fontStyle=0;" vertex="1"><mxGeometry x="12" y="30" width="215.7" height="67.2" as="geometry" /></mxCell><mxCell id="moe_switch_transformers_2-x847" parent="moe_switch_transformers_2-figure" value="•" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Source Sans 3;fontSize=14;fontColor=#000000;fontStyle=0;" vertex="1"><mxGeometry x="0" y="109.2" width="5.9" height="16.8" as="geometry" /></mxCell><mxCell id="moe_switch_transformers_2-x848" parent="moe_switch_transformers_2-figure" value="&lt;b&gt;&lt;b&gt;Expert Capacity&lt;/b&gt;:&lt;/b&gt; Batch size of each&lt;br&gt;expert. Calculated as&lt;br&gt;(tokens_per_batch / num_experts) *&lt;br&gt;capacity_factor" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Source Sans 3;fontSize=14;fontColor=#000000;fontStyle=0;" vertex="1"><mxGeometry x="12" y="109.2" width="202.78" height="67.2" as="geometry" /></mxCell><mxCell id="moe_switch_transformers_2-x849" parent="moe_switch_transformers_2-figure" value="•" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Source Sans 3;fontSize=14;fontColor=#000000;fontStyle=0;" vertex="1"><mxGeometry x="0" y="188.4" width="5.9" height="16.8" as="geometry" /></mxCell><mxCell id="moe_switch_transformers_2-x850" parent="moe_switch_transformers_2-figure" value="&lt;b&gt;&lt;b&gt;Capacity Factor&lt;/b&gt;:&lt;/b&gt; Used when&lt;br&gt;calculating expert capacity. Expert&lt;br&gt;capacity allows more buffer to help&lt;br&gt;mitigate token overflow during&lt;br&gt;routing." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Source Sans 3;fontSize=14;fontColor=#000000;fontStyle=0;" vertex="1"><mxGeometry x="12" y="188.4" width="205.7" height="84" as="geometry" /></mxCell><mxCell id="moe_switch_transformers_2-x851" parent="moe_switch_transformers_2-figure" value="" style="endArrow=none;endFill=1;endSize=6;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.6;fontFamily=Source Sans 3;fontSize=14;fontColor=#000000;dashPattern=1 2;dashed=1;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="246" y="0" as="sourcePoint" /><mxPoint x="246" y="330" as="targetPoint" /></mxGeometry></mxCell><mxCell id="moe_switch_transformers_2-x852" parent="moe_switch_transformers_2-figure" value="Capacity Factor: 1.0" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;fontFamily=Source Sans 3;fontSize=14;fontColor=#000000;fontStyle=1;" vertex="1"><mxGeometry x="311.26" y="0" width="123.47" height="16.8" as="geometry" /></mxCell><mxCell id="moe_switch_transformers_2-x853" parent="moe_switch_transformers_2-figure" value="Expert 1" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;fontFamily=Source Sans 3;fontSize=14;fontColor=#000000;fontStyle=0;" vertex="1"><mxGeometry x="270.59" y="26" width="48.82" height="1