        <mxCell id="autodiff-2" value="&lt;i&gt;f&lt;/i&gt;(&lt;i&gt;x&lt;/i&gt;) = √&lt;span style=&quot;border-top: 1px solid #000000; padding-top: 4px;&quot;&gt;&lt;i&gt;x&lt;/i&gt;&lt;sup&gt;2&lt;/sup&gt; + exp(&lt;i&gt;x&lt;/i&gt;&lt;sup&gt;2&lt;/sup&gt;)&lt;/span&gt; + cos(&lt;i&gt;x&lt;/i&gt;&lt;sup&gt;2&lt;/sup&gt; + exp(&lt;i&gt;x&lt;/i&gt;&lt;sup&gt;2&lt;/sup&gt;))" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=17;" vertex="1" parent="autodiff-figure">
