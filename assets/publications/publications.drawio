        <mxCell id="gpt3_fig11-63" value="sequence #3" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13.1;fontColor=#666666;whiteSpace=nowrap;spacing=0;spacingLeft=3;spacingRight=3;fontStyle=2;" vertex="1" parent="gpt3_fig11-figure">
          <mxGeometry x="813.4617" y="464.28" width="83.018" height="19.72" as="geometry" />
        </mxCell>
        <mxCell id="gpt3_fig11-64" value="&lt;b&gt;Language model meta-learning.&lt;/b&gt; During unsupervised pre-training, a language model develops a broad set of skills and pattern recognition abilities. It then uses these abilities at inference time to rapidly adapt to or recognize the desired task. We use the term “in-context learning” to describe the inner loop of this process, which occurs within the forward-pass upon each sequence. The sequences in this diagram are not intended to be representative of the data a model would see during pre-training, but are intended to show that there are sometimes repeated sub-tasks embedded within a single sequence." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18.6;fontColor=#000000;" vertex="1" parent="gpt3_fig11-figure">
          <mxGeometry x="0" y="498" width="988.7707" height="141.9" as="geometry" />
        </mxCell>
