        <mxCell id="siamese_networks-59" value="Our general strategy. 1) Train a model to discriminate between a collection of same/different pairs. 2) Generalize to evaluate new categories based on learned feature mappings for verification." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24.9;fontColor=#000000;" vertex="1" parent="siamese_networks-figure">
