        <mxCell id="graph_transformer_networks-368" value="GCN" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12.6;whiteSpace=nowrap;spacing=0;spacingLeft=3;spacingRight=3;" vertex="1" parent="graph_transformer_networks-figure">
