        <mxCell id="sample_sort-98" value="10" style="html=1;whiteSpace=wrap;fillColor=#d5e8d4;fontSize=14.6;fontColor=#000000;align=center;verticalAlign=middle;spacing=0;spacingLeft=10.4;spacingRight=10.4;spacingTop=0;spacingBottom=0;strokeColor=#000000;strokeWidth=1.04;" vertex="1" parent="sample_sort-figure">
