;strokeColor=#999999;strokeWidth=0.4;fillColor=#e1d5e7;verticalAlign=middle;align=center;spacing=0;" vertex="1"><mxGeometry x="480" y="120" width="20" height="20" as="geometry" /></mxCell><mxCell id="odd_even_sort-x79" parent="odd_even_sort-figure" value="12" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Source Sans 3;fontSize=12;fontColor=#000000;strokeColor=#999999;strokeWidth=0.4;fillColor=#e1d5e7;verticalAlign=middle;align=center;spacing=0;" vertex="1"><mxGeometry x="500" y="120" width="20" height="20" as="geometry" /></mxCell><mxCell id="odd_even_sort-x80" parent="odd_even_sort-figure" value="&lt;b&gt;Step 2:&lt;/b&gt; perform the following loop &lt;span style=&quot;font-family: NewComputerModernSansMath;&quot;&gt;𝑝&lt;/span&gt; times (where &lt;span style=&quot;font-family: NewComputerModernSansMath;&quot;&gt;𝑝 = 5&lt;/span&gt; ranks, and &lt;span style=&quot;font-family: NewComputerModernSansMath;&quot;&gt;𝑖 = 0&lt;/span&gt; to 4):" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Source Sans 3;fontSize=14;fontColor=#000000;fontStyle=0;" vertex="1"><mxGeometry x="0" y="172" width="459.2" height="16.8" as="geometry" /></mxCell><mxCell id="odd_even_sort-x201" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#666666;strokeWidth=1.4;" edge="1" parent="odd_even_sort-figure"><mxGeometry relative="1" as="geometry"><mxPoint x="8" y="196" as="sourcePoint" /><mxPoint x="16" y="515" as="targetPoint" /><Array as="points"><mxPoint x="8" y="515" /></Array></mxGeometry></mxCell><mxCell id="odd_even_sort-x81" parent="odd_even_sort-figure" value="&lt;b&gt;Step 2.1:&lt;/b&gt; each rank sends its whole data to one neighbor and receives its neighbor's data:" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Source Sans 3;fontSize=14;fontColor=#000000;fontStyle=0;" vertex="1"><mxGeometry x="20" y="200" width="523.9" height="16.8" as="geometry" /></mxCell><mxCell id="odd_even_sort-x82" parent="odd_even_sort-figure" value="&lt;i&gt;if &lt;span style=&quot;font-family: NewComputerModernSansMath; font-style: normal;&quot;&gt;𝑖&lt;/span&gt; is even:&lt;/i&gt; each odd rank exchanges data with the even rank on its &lt;i&gt;left&lt;/i&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Source Sans 3;fontSize=14;fontColor=#000000;fontStyle=0;" vertex="1"><mxGeometry x="40" y="228" width="406.7" height="16.8" as="geometry" /></mxCell><mxCell id="odd_even_sort-x83" parent="odd_even_sort-figure" value="1" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Source Sans 3;fontSize=12;fontColor=#000000;strokeColor=#999999;strokeWidth=0.4;fillColor=#dae8fc;verticalAlign=middle;align=center;spacing=0;" vertex="1"><mxGeometry x="40" y="252" width="20" height="20" as="geometry" /></mxCell><mxCell id="odd_even_sort-x84" parent="odd_even_sort-figure" value="3" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Source Sans 3;fontSize=12;fontColor=#000000;strokeColor=#999999;strokeWidth=0.4;fillColor=#dae8fc;verticalAlign=middle;align=center;spacing=0;" vertex="1"><mxGeometry x="60" y="252" width="20" height="20" as="geometry" /></mxCell><mxCell id="odd_even_sort-x85" parent="odd_even_sort-figure" value="20" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Source Sans 3;fontSize=12;fontColor=#000000;strokeColor=#999999;strokeWidth=0.4;fillColor=#dae8fc;verticalAlign=middle;align=center;spacing=0;" vertex="1"><mxGeometry x="80" y="252" width="20" height="20" as="geometry" /></mxCell><mxCell id="odd_even_sort-x86" parent="odd_even_sort-figure" value="22" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Source Sans 3;fontSize=12;fontColor=#000000;strokeColor=#999999;strokeWidth=0.4;fillColor=#dae8fc;verticalAlign=middle;align=center;spacing=0;" vertex="1"><mxGeometry x="100" y="252" width="20" height="20" as="geometry" /></mxCell><mxCell id="odd_even_sort-x87" parent="odd_even_sort-figure" value="−2" style="rounded=