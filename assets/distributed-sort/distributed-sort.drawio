ce Sans 3;fontSize=12;fontColor=#000000;strokeColor=#999999;strokeWidth=0.4;fillColor=#fff2cc;verticalAlign=middle;align=center;spacing=0;" vertex="1"><mxGeometry x="230" y="412" width="20" height="20" as="geometry" /></mxCell><mxCell id="sample_sort-cb-15" value="" edge="1" parent="sample_sort-figure" style="endArrow=none;startArrow=none;html=1;rounded=0;strokeColor=#000000;strokeWidth=0.6;"><mxGeometry relative="1" as="geometry"><mxPoint x="230" y="412" as="sourcePoint" /><mxPoint x="230" y="432" as="targetPoint" /></mxGeometry></mxCell><mxCell id="sample_sort-x249" parent="sample_sort-figure" value="5" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Source Sans 3;fontSize=12;fontColor=#000000;strokeColor=#999999;strokeWidth=0.4;fillColor=#ffffff;verticalAlign=middle;align=center;spacing=0;" vertex="1"><mxGeometry x="250" y="412" width="20" height="20" as="geometry" /></mxCell><mxCell id="sample_sort-cb-16" value="" edge="1" parent="sample_sort-figure" style="endArrow=none;startArrow=none;html=1;rounded=0;strokeColor=#000000;strokeWidth=0.6;"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="412" as="sourcePoint" /><mxPoint x="250" y="432" as="targetPoint" /></mxGeometry></mxCell><mxCell id="sample_sort-x250" parent="sample_sort-figure" value="7" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Source Sans 3;fontSize=12;fontColor=#000000;strokeColor=#999999;strokeWidth=0.4;fillColor=#ffffff;verticalAlign=middle;align=center;spacing=0;" vertex="1"><mxGeometry x="270" y="412" width="20" height="20" as="geometry" /></mxCell><mxCell id="sample_sort-x251" parent="sample_sort-figure" value="10" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Source Sans 3;fontSize=12;fontColor=#000000;strokeColor=#999999;strokeWidth=0.4;fillColor=#fff2cc;verticalAlign=middle;align=center;spacing=0;" vertex="1"><mxGeometry x="290" y="412" width="20" height="20" as="geometry" /></mxCell><mxCell id="sample_sort-cb-17" value="" edge="1" parent="sample_sort-figure" style="endArrow=none;startArrow=none;html=1;rounded=0;strokeColor=#000000;strokeWidth=0.6;"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="412" as="sourcePoint" /><mxPoint x="290" y="432" as="targetPoint" /></mxGeometry></mxCell><mxCell id="sample_sort-x252" parent="sample_sort-figure" value="&lt;b&gt;Step 3:&lt;/b&gt; rank 0 sorts the received samples, takes every &lt;span style=&quot;font-family: NewComputerModernSansMath;&quot;&gt;𝑝&lt;/span&gt;-th one as a splitter," style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Source Sans 3;fontSize=14;fontColor=#000000;fontStyle=0;" vertex="1"><mxGeometry x="0" y="336" width="438.7" height="16.8" as="geometry" /></mxCell><mxCell id="sample_sort-x302" parent="sample_sort-figure" value="and broadcasts the splitters to all ranks. The splitters represent &lt;i&gt;which elements&lt;/i&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Source Sans 3;fontSize=14;fontColor=#000000;fontStyle=0;" vertex="1"><mxGeometry x="20" y="360" width="461.3" height="16.8" as="geometry" /></mxCell><mxCell id="sample_sort-x303" parent="sample_sort-figure" value="&lt;i&gt;should be sent to which rank&lt;/i&gt;:" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Source Sans 3;fontSize=14;fontColor=#000000;fontStyle=0;" vertex="1"><mxGeometry x="20" y="384" width="167.3" height="16.8" as="geometry" /></mxCell><mxCell id="sample_sort-x253" parent="sample_sort-figure" value="All ranks now hold the splitters 4 and 10. In practice, this means that:" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Source Sans 3;fontSize=14;fontColor=#000000;fontStyle=0;" vertex="1"><mxGeometry x="20" y="528" width="401.1" height="16.8" as="geometry" /></mxCell><mxCell id="sample_sort-x360" parent="sample_sort-figure" value="– rank 0 receives all elements below 4;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Source Sans 3;fontSize=14;fontColor=#000000;fontStyle=0;" vertex="1"><mxGeometry x="20" y="550" width="223.5" height="16.8" as="geometry" /></mxCell><mxCell id="sample_sort-x361" parent="sample_sort-figure" value="– rank 1 receives all elements from 4 up to 10 (excluded);" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Source Sans 3;fontSize=14;fontColor=#000000;fontStyle=0;" vertex="1"><mxGeometry x="20" y="572" width="330.3" height="16.8" as="geometry" /></mxCell><mxCell id="sample_sort-x362" parent="sample_sort-figure" value="– rank 2 receives all elements from 10 upwards." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Source Sans 3;fontSize=14;fontColor=#000000;fontStyle=0;" vertex="1"><mxGeometry x="20" y="594" width="276.5" height="16.8" as="geometry" /></mxCell><mxCell id="sample_sort-x254" parent="sample_sort-figure" value="&lt;b&gt;Step 4:&lt;/b&gt; each rank sends each element to the rank of its interval, and sorts" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Source Sans 3;fontSize=14;fontColor=#000000;fontStyle=0;" vertex="1"><mxGeometry x="0" y="636" width="428.7" height="16.8" as="geometry" /></mxCell><mxCell id="sample_sort-x255" parent="sample_sort-figure" value="the elements it receives. As the splitters divide the range of values in the order" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Source Sans 3;fontSize=14;fontColor=#000000;fontStyle=0;" vertex="1"><mxGeometry x="20" y="660" width="454.3" height="16.8" as="geometry" /></mxCell><mxCell id="sample_sort-x370" parent="sample_sort-figure" value="of the ranks, the final data is sorted across all ranks, but imbalanced:" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Source Sans 3;fontSize=14;fontColor=#000000;fontStyle=0;" vertex="1"><mxGeometry x="20" y="684" width="400.7" height="16.8" as="geometry" /></mxCell><mxCell id="sample_sort-x256" parent="sample_sort-figure" value="rank 0: &lt;span style=&quot;font-family: NewComputerModernSansMath;&quot;&gt;𝑥 &amp;lt; 4&lt;/span&gt;" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;fontFamily=Source Sans 3;fontSize=14;fontColor=#000000;fontStyle=0;" vertex="1"><mxGeometry x="71.4" y="712" width="77.2" height="16.8" as="geometry" /></mxCell><mxCell id="sample_sort-x257" parent="sample_sort-figure" value="−9" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Source Sans 3;fontSize=12;fontColor=#000000;strokeColor=#999999;strokeWidth=0.4;fillColor=#dae8fc;verticalAlign=middle;align=center;spacing=0;" vertex="1"><mxGeometry x="20" y="732" width="20" height="20" as="geometry" /></mxCell><mxCell id="sample_sort-x258" parent="sample_sort-figure" value="−8" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Source Sans 3;fontSize=12;fontColor=#000000;strokeColor=#999999;strokeWidth=0.4;fillColor=#dae8fc;verticalAlign=middle;align=center;spacing=0;" vertex="1"><mxGeometry x="40" y="732" width="20" height="20" as="geometry" /></mxCell><mxCell id="sample_sort-x259" parent="sample_sort-figure" value="−7" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Source Sans 3;fontSize=12;fontColor=#000000;strokeColor=#999999;strokeWidth=0.4;fillColor=#dae8fc;verticalAlign=middle;align=center;spacing=0;" vertex="1"><mxGeometry x="60" y="732" width="20" height="20" as="geometry" /></mxCell><mxCell id="sample_sort-x260" parent="sample_sort-figure" value="−6" style="rounded=0;whiteSpace=nowrap;html=1;fontFamily=Source Sans 3;fontSize=12;fontColor=#000000;strokeColor=#999999;strokeWidth=0.4;fillColor=#dae8fc;verticalAlign=middle;align=center;spacing=0;" vertex="1"><mxGeometry x="80" y="732" width="20" height="20" as="geometry" /></mxCell><mxCell id="sample_sort-x261" parent="sample_sort-figure" value="−3" style="rounded=0;whiteS