        </mxCell>
        <mxCell id="sample_sort-99" value="&lt;b&gt;Step 4&lt;/b&gt;: Each CPU sends the portion of its segments to the corresponding CPU - as given&lt;br&gt;by the samples - and sorts the data it receives. As the samples split the range of values&lt;br&gt;in the order of the CPUs' ranks, the final data is sorted across all CPUs." style="text;html=1;whiteSpace=nowrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=20.8;fontColor=#000000;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=1.56;spacingBottom=-1.56;" vertex="1" parent="sample_sort-figure">
          <mxGeometry x="6.7292" y="809.8125" width="831.25" height="75" as="geometry" />
        </mxCell>
        <mxCell id="sample_sort-100" value="All cpus have now the [4,10,30] samples. In practice this means that: &lt;br&gt;- cpu 0 will receive all data below 4&lt;br&gt;- cpu 1 will receive all data from 4 up to 10 (excluded)&lt;br&gt;- cpu 2 will receive all data from 10 up to 30" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=18.8;fontColor=#000000;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=1.56;spacingBottom=-1.56;" vertex="1" parent="sample_sort-figure">
